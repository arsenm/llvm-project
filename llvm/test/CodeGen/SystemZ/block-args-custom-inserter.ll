; CHECK-NEXT:    risbg %r1, %r2, 0, 189, 0
; CHECK-NEXT:    l %r0, 0(%r1)
; CHECK-NEXT:    sll %r3, 24
; CHECK-NEXT:    sll %r2, 3
; CHECK-NEXT:    lcr %r4, %r2
; CHECK-NEXT:  .LBB1_1: # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    rll %r5, %r0, 0(%r2)
; CHECK-NEXT:    crjle %r5, %r3, .LBB1_3
; CHECK-NEXT:  # %bb.2: # in Loop: Header=BB1_1 Depth=1
; CHECK-NEXT:    risbg %r5, %r3, 32, 39, 0
; CHECK-NEXT:  .LBB1_3: # in Loop: Header=BB1_1 Depth=1
; CHECK-NEXT:    rll %r5, %r5, 0(%r4)
; CHECK-NEXT:    cs %r0, %r5, 0(%r1)
; CHECK-NEXT:    jl .LBB1_1
; CHECK-NEXT:  # %bb.4:
; CHECK-NEXT:    rll %r2, %r0, 8(%r2)
; CHECK-NEXT:    br %r14
  %r = atomicrmw min ptr %p, i8 %v seq_cst
  ret i8 %r
}

