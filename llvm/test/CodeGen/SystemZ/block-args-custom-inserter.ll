; RUN: llc -mtriple=s390x-linux-gnu -sdag-use-block-args -verify-machineinstrs < %s | FileCheck %s

; SystemZ custom inserters build value merges for selects, atomic loops, the
; memory and string loops, probed alloca, and setjmp. Under -sdag-use-block-args
; those merges must be block arguments fed by SUCC_ARGS, not machine PHIs. The
; loop inserters build their loop-header merges after the loop body so the
; self-edge SUCC_ARGS forwarders land in the terminator-adjacent cluster.

@g = global i32 0

define i32 @select_custom_inserter(i32 %a, i32 %b) {
; CHECK-LABEL: select_custom_inserter:
; CHECK:       # %bb.0:
; CHECK-NEXT:    larl %r1, g@GOT
; CHECK-NEXT:    chsi 4(%r1), 0
; CHECK-NEXT:    blhr %r14
; CHECK-NEXT:  .LBB0_1:
; CHECK-NEXT:    lr %r2, %r3
; CHECK-NEXT:    br %r14
  %c = icmp ne i32 ptrtoint (ptr @g to i32), 0
  %r = select i1 %c, i32 %a, i32 %b
  ret i32 %r
}

