# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-tailduplication -tail-dup-pred-size=1 -tail-dup-succ-size=1 -o - %s | FileCheck %s

# bb.5 is an indirect-jump block taking a block argument, with multiple
# predecessors and multiple successors. Like the PHI equivalent, it is not
# tail-duplicated pre-regalloc: duplicating it into each predecessor would
# multiply the SUCC_ARGS forwarding (see shouldTailDuplicate).
--- |
  @computed_goto.dispatch = constant [5 x ptr] [ptr null, ptr blockaddress(@computed_goto, %bb1), ptr blockaddress(@computed_goto, %bb2), ptr blockaddress(@computed_goto, %bb3), ptr blockaddress(@computed_goto, %bb4)]
  declare i64 @f0()
  define void @computed_goto() {
    start:
      ret void
    bb1:
      ret void
    bb2:
      ret void
    bb3:
      ret void
    bb4:
      ret void
  }
...
---
name:            computed_goto
tracksRegLiveness: true
usesBlockArgs: true
body:             |
  ; CHECK-LABEL: name: computed_goto
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:gr64_nosp = IMPLICIT_DEF
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[DEF]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.bb1 (ir-block-address-taken %ir-block.bb1):
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:gr64_nosp = IMPLICIT_DEF
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[DEF1]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.bb2 (ir-block-address-taken %ir-block.bb2):
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF2:%[0-9]+]]:gr64_nosp = IMPLICIT_DEF
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[DEF2]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JMP64m $noreg, 8, %3:gr64_nosp, @computed_goto.dispatch, $noreg
  bb.0:
    successors: %bb.5
    %1:gr64_nosp = IMPLICIT_DEF
    SUCC_ARGS %bb.5, %1
    JMP_1 %bb.5

  bb.1.bb1 (ir-block-address-taken %ir-block.bb1):
    successors: %bb.5
    %3:gr64_nosp = IMPLICIT_DEF
    SUCC_ARGS %bb.5, %3
    JMP_1 %bb.5

  bb.2.bb2 (ir-block-address-taken %ir-block.bb2):
    successors: %bb.5
    %5:gr64_nosp = IMPLICIT_DEF
    SUCC_ARGS %bb.5, %5
    JMP_1 %bb.5

  bb.5:
    successors: %bb.1, %bb.2
    arguments: %10:gr64_nosp
    JMP64m $noreg, 8, %10, @computed_goto.dispatch, $noreg
...
