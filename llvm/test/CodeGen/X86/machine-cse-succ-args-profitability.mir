# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=machine-cse -o - %s | FileCheck %s

# A common subexpression whose value is forwarded to a block argument is not
# reused from another block, like one used by a PHI.

---
name: succ_args_use_not_reused
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: succ_args_use_not_reused
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr [[COPY]], [[COPY1]], implicit-def dead $eflags
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[ADD32rr]]
  ; CHECK-NEXT:   JCC_1 %bb.3, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD32rr1:%[0-9]+]]:gr32 = ADD32rr [[COPY]], [[COPY1]], implicit-def dead $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[ADD32rr1]]
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = COPY %4:gr32
  ; CHECK-NEXT:   RET64 implicit $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   arguments: %5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = COPY %5:gr32
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    TEST32rr %0, %0, implicit-def $eflags
    SUCC_ARGS %bb.3, %2
    JCC_1 %bb.3, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    %3:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    SUCC_ARGS %bb.2, %3
    JMP_1 %bb.2

  bb.2:
    arguments: %4:gr32
    $eax = COPY %4
    RET64 implicit $eax

  bb.3:
    arguments: %5:gr32
    $eax = COPY %5
    RET64 implicit $eax
...

# Forwarding both values to the same block argument does not increase register
# pressure, like two incoming values of the same PHI.

---
name: succ_args_same_target_reused
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: succ_args_same_target_reused
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[MOV32ri]]
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[MOV32ri]]
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = COPY %3:gr32
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = MOV32ri 1
    TEST32rr %0, %0, implicit-def $eflags
    SUCC_ARGS %bb.2, %1
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    %2:gr32 = MOV32ri 1
    SUCC_ARGS %bb.2, %2
    JMP_1 %bb.2

  bb.2:
    arguments: %3:gr32
    $eax = COPY %3
    RET64 implicit $eax
...
