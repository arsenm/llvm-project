# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=machine-sink -verify-machineinstrs -o - %s | FileCheck %s

# MachineSink sinks %2 across the critical edge bb.1 -> bb.3 (into a block whose
# argument it forwards), splitting the edge. The new block is not a layout
# successor of bb.3, so SplitCriticalEdge inserts a branch into it; the relocated
# SUCC_ARGS must precede that branch rather than trail it.
---
name: sink_succ_args_split
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: sink_succ_args_split
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr8 = COPY $dil
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY $rsi
  ; CHECK-NEXT:   TEST8ri [[COPY]], 1, implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[COPY1]]
  ; CHECK-NEXT:   JCC_1 %bb.3, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV8ri:%[0-9]+]]:gr8 = MOV8ri 1
  ; CHECK-NEXT:   TEST8rr [[MOV8ri]], [[MOV8ri]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD64ri32_:%[0-9]+]]:gr64 = ADD64ri32 [[COPY1]], 1, implicit-def dead $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[ADD64ri32_]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $rax = MOV64ri 0
  ; CHECK-NEXT:   RET 0, $rax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   arguments: %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $rax = COPY %4:gr64
  ; CHECK-NEXT:   RET 0, $rax
  bb.0:
    successors: %bb.3, %bb.1
    liveins: $edi, $rsi
    %0:gr8 = COPY $dil
    %1:gr64 = COPY $rsi
    %2:gr64 = ADD64ri32 %1, 1, implicit-def dead $eflags
    TEST8ri %0, 1, implicit-def $eflags
    SUCC_ARGS %bb.3, %1
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3, %bb.2
    %3:gr8 = MOV8ri 1
    TEST8rr %3, %3, implicit-def $eflags
    SUCC_ARGS %bb.3, %2
    JCC_1 %bb.3, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $rax = MOV64ri 0
    RET 0, $rax

  bb.3:
    arguments: %4:gr64
    $rax = COPY %4:gr64
    RET 0, $rax
...
