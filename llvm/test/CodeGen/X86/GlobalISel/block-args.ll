; RUN: llc -mtriple=x86_64-unknown-linux-gnu -global-isel -gisel-use-block-args -verify-machineinstrs < %s | FileCheck %s
; RUN: llc -mtriple=x86_64-unknown-linux-gnu -global-isel -verify-machineinstrs < %s | FileCheck %s

; Exercise X86 GISel G_SUCC_ARGS selection and conditional-branch clustering: a
; loop-carried value is forwarded via SUCC_ARGS, and the loop back-edge's
; G_BRCOND selects to a TEST/JCC pair whose TEST must stay clustered before the
; SUCC_ARGS forwarder rather than after it.
define i64 @loop_carried(i64 %n, i64 %a, i64 %b) {
; CHECK-LABEL: loop_carried:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    movq %rsi, %rax
; CHECK-NEXT:    xorl %ecx, %ecx
; CHECK-NEXT:    subq %rdx, %rax
; CHECK-NEXT:    .p2align 4
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    incq %rcx
; CHECK-NEXT:    addq %rdx, %rax
; CHECK-NEXT:    cmpq %rdi, %rcx
; CHECK-NEXT:    setb %sil
; CHECK-NEXT:    testb $1, %sil
; CHECK-NEXT:    jne .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    retq
entry:
  br label %loop
loop:
  %iv = phi i64 [ 0, %entry ], [ %iv.next, %loop ]
  %acc = phi i64 [ %a, %entry ], [ %acc.next, %loop ]
  %acc.next = add i64 %acc, %b
  %iv.next = add i64 %iv, 1
  %c = icmp ult i64 %iv.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i64 %acc
}
