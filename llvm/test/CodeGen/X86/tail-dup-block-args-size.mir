# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-tailduplication -o - %s | FileCheck %s

# A SUCC_ARGS does not count towards the size of the block to duplicate, like a
# PHI in its successor.

---
name: succ_args_not_counted
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: succ_args_not_counted
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr [[COPY]], [[COPY1]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[INC32r:%[0-9]+]]:gr32 = INC32r [[ADD32rr]], implicit-def dead $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[INC32r]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[SUB32rr:%[0-9]+]]:gr32 = SUB32rr [[COPY]], [[COPY1]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[INC32r1:%[0-9]+]]:gr32 = INC32r [[SUB32rr]], implicit-def dead $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[INC32r1]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   arguments: %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = COPY %4:gr32
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.4
    %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    SUCC_ARGS %bb.4, %2
    JMP_1 %bb.4

  bb.2:
    successors: %bb.4
    %3:gr32 = SUB32rr %0, %1, implicit-def dead $eflags
    SUCC_ARGS %bb.4, %3
    JMP_1 %bb.4

  bb.3:
    arguments: %6:gr32
    $eax = COPY %6
    RET64 implicit $eax

  bb.4:
    successors: %bb.3
    arguments: %4:gr32
    %5:gr32 = INC32r %4, implicit-def dead $eflags
    SUCC_ARGS %bb.3, %5
    JMP_1 %bb.3
...
