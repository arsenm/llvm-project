# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=dead-mi-elimination -o - %s | FileCheck %s

# An unused block argument is deleted along with its forwarded values, like an
# unused PHI.

---
name: dead_block_arg
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: dead_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[COPY]]
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[COPY1]]
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = COPY %4:gr32
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    TEST32rr %0, %0, implicit-def $eflags
    SUCC_ARGS %bb.2, %0, %2
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    %3:gr32 = SUB32rr %0, %1, implicit-def dead $eflags
    SUCC_ARGS %bb.2, %1, %3
    JMP_1 %bb.2

  bb.2:
    arguments: %4:gr32, %5:gr32
    $eax = COPY %4
    RET64 implicit $eax
...

# The value forwarded around the backedge is only deleted on another iteration.

---
name: dead_loop_block_arg
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: dead_loop_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   arguments: %2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEC32r:%[0-9]+]]:gr32 = DEC32r %2:gr32, implicit-def dead $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32rr [[DEC32r]], [[DEC32r]], implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[DEC32r]]
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $eax = COPY [[DEC32r]]
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = MOV32r0 implicit-def dead $eflags
    SUCC_ARGS %bb.1, %0, %1
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    arguments: %2:gr32, %3:gr32
    %4:gr32 = DEC32r %2, implicit-def $eflags
    JMP_1 %bb.2

  bb.2:
    successors: %bb.1, %bb.3
    %5:gr32 = ADD32ri %4, 7, implicit-def dead $eflags
    TEST32rr %4, %4, implicit-def $eflags
    SUCC_ARGS %bb.1, %4, %5
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.3

  bb.3:
    $eax = COPY %4
    RET64 implicit $eax
...
