# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-tailduplication %s -o - | FileCheck %s

# A block argument (%0 on the loop header bb.2) is read in the backedge block
# bb.4 as `ADD64ri32 %0, 64`. When early-tailduplication duplicates bb.2 into the
# entry predecessor bb.0, the block-argument value must be reconciled with a PHI
# so bb.4 reads %0 on the loop-body edge and the entry value (%3) on the
# duplicated edge. SSAUpdater only sees the block argument as an available value
# if TailDuplicator recovers its owning block via getBlockArgDef (a block
# argument has no defining instruction). Without that, the use in bb.4 is
# misresolved to the single entry value %3, collapsing the loop-carried iterator
# to a constant and producing an infinite loop.
---
name:            loop_carried_block_arg
tracksRegLiveness: true
isSSA:           true
usesBlockArgs:   true
registers:
  - { id: 0, class: gr64 }
  - { id: 1, class: gr64 }
  - { id: 2, class: gr64 }
  - { id: 3, class: gr64 }
  - { id: 4, class: gr32 }
  - { id: 5, class: gr64_nosp }
  - { id: 6, class: gr64 }
  - { id: 7, class: gr64 }
  - { id: 8, class: gr64 }
  - { id: 9, class: gr64 }
  - { id: 10, class: gr64 }
liveins:
  - { reg: '$rdi', virtual-reg: '%1' }
  - { reg: '$rsi', virtual-reg: '%2' }
jumpTable:
  kind:            label-difference32
  entries:
    - id:              0
      blocks:          [ '%bb.1', '%bb.3', '%bb.4', '%bb.3', '%bb.3', '%bb.1',
                         '%bb.3', '%bb.3', '%bb.3', '%bb.3', '%bb.3', '%bb.4' ]
body:             |
  ; CHECK-LABEL: name: loop_carried_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x04000000), %bb.4(0x00000000), %bb.5(0x7c000000)
  ; CHECK-NEXT:   liveins: $rdi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rsi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   [[SUBREG_TO_REG:%[0-9]+]]:gr64 = SUBREG_TO_REG killed [[MOV32r0_]], %subreg.sub_32bit
  ; CHECK-NEXT:   [[ADD64ri32_:%[0-9]+]]:gr64_nosp = ADD64ri32 [[COPY]], -3, implicit-def dead $eflags
  ; CHECK-NEXT:   [[LEA64r:%[0-9]+]]:gr64 = LEA64r $rip, 1, $noreg, %jump-table.0, $noreg
  ; CHECK-NEXT:   [[MOVSX64rm32_:%[0-9]+]]:gr64 = MOVSX64rm32 [[LEA64r]], 4, [[ADD64ri32_]], 0, $noreg :: (load (s32) from jump-table)
  ; CHECK-NEXT:   [[ADD64rr:%[0-9]+]]:gr64 = ADD64rr [[LEA64r]], [[MOVSX64rm32_]], implicit-def dead $eflags
  ; CHECK-NEXT:   JMP64r [[ADD64rr]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.1(0x04000000), %bb.4(0x00000000), %bb.5(0x7c000000)
  ; CHECK-NEXT:   arguments: %0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD64ri32_1:%[0-9]+]]:gr64_nosp = ADD64ri32 [[COPY]], -3, implicit-def dead $eflags
  ; CHECK-NEXT:   [[LEA64r1:%[0-9]+]]:gr64 = LEA64r $rip, 1, $noreg, %jump-table.0, $noreg
  ; CHECK-NEXT:   [[MOVSX64rm32_1:%[0-9]+]]:gr64 = MOVSX64rm32 [[LEA64r1]], 4, [[ADD64ri32_1]], 0, $noreg :: (load (s32) from jump-table)
  ; CHECK-NEXT:   [[ADD64rr1:%[0-9]+]]:gr64 = ADD64rr [[LEA64r1]], [[MOVSX64rm32_1]], implicit-def dead $eflags
  ; CHECK-NEXT:   JMP64r [[ADD64rr1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors:
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TRAP
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.1(0x04000000), %bb.2(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gr64 = PHI %0:gr64, %bb.2, [[SUBREG_TO_REG]], %bb.0
  ; CHECK-NEXT:   [[ADD64ri32_2:%[0-9]+]]:gr64 = ADD64ri32 [[PHI]], 64, implicit-def dead $eflags
  ; CHECK-NEXT:   [[SUB64rr:%[0-9]+]]:gr64 = SUB64rr [[ADD64ri32_2]], [[COPY1]], implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[COPY1]]
  ; CHECK-NEXT:   JCC_1 %bb.1, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  bb.0:
    successors: %bb.2(0x80000000)
    liveins: $rdi, $rsi

    %2:gr64 = COPY $rsi
    %1:gr64 = COPY $rdi
    %4:gr32 = MOV32r0 implicit-def dead $eflags
    %3:gr64 = SUBREG_TO_REG killed %4, %subreg.sub_32bit
    SUCC_ARGS %bb.2, %3
    JMP_1 %bb.2

  bb.1:
    RET 0

  bb.2:
    successors: %bb.5(0x80000000)
    arguments: %0

    %5:gr64_nosp = ADD64ri32 %2, -3, implicit-def dead $eflags

  bb.5:
    successors: %bb.1(0x04000000), %bb.3(0x00000000), %bb.4(0x7c000000)

    %6:gr64 = LEA64r $rip, 1, $noreg, %jump-table.0, $noreg
    %7:gr64 = MOVSX64rm32 %6, 4, %5, 0, $noreg :: (load (s32) from jump-table)
    %8:gr64 = ADD64rr %6, killed %7, implicit-def dead $eflags
    JMP64r killed %8

  bb.3:
    successors:

    TRAP

  bb.4:
    successors: %bb.1(0x04000000), %bb.2(0x7c000000)

    %9:gr64 = ADD64ri32 %0:gr64, 64, implicit-def dead $eflags
    %10:gr64 = SUB64rr %9, %1, implicit-def $eflags
    SUCC_ARGS %bb.2, %1
    JCC_1 %bb.1, 4, implicit $eflags
    JMP_1 %bb.2
...
