# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=opt-phis -o - %s | FileCheck %s

# A block argument whose forwarded values are all copies of one register (the
# loop-invariant zero %0) is folded to that register.
---
name: single_value_block_arg_cycle
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: single_value_block_arg_cycle
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 0
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
  ; CHECK-NEXT:   TEST32rr [[MOV32ri]], [[MOV32ri]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $eax = COPY [[MOV32ri]]
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1
    %0:gr32 = MOV32ri 0
    SUCC_ARGS %bb.1, %0
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    arguments: %1:gr32
    %2:gr32 = COPY %1
    TEST32rr %1, %1, implicit-def $eflags
    SUCC_ARGS %bb.1, %2
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %1
    RET64 implicit $eax
...

# A block argument updated in the loop (incremented) is not a single-value
# cycle and is preserved.
---
name: varying_block_arg_not_folded
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: varying_block_arg_not_folded
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 0
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[MOV32ri]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   arguments: %1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[INC32r:%[0-9]+]]:gr32 = INC32r %1:gr32, implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[INC32r]]
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $eax = COPY %1:gr32
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1
    %0:gr32 = MOV32ri 0
    SUCC_ARGS %bb.1, %0
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    arguments: %1:gr32
    %2:gr32 = INC32r %1, implicit-def $eflags
    SUCC_ARGS %bb.1, %2
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %1
    RET64 implicit $eax
...
