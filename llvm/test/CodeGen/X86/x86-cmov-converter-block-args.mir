# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-pc-linux -run-pass=x86-cmov-conversion -x86-cmov-converter=true -o - %s | FileCheck %s

# The CMOV feeds a loop-carried block argument on the critical path through the
# load address, so it is converted to a branch like with a loop header PHI.

--- |
  ; ModuleID = '/tmp/ctm/maxindex.ll'
  source_filename = "/tmp/ctm/maxindex.ll"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-pc-linux"

  define i32 @MaxIndex(i32 %n, ptr readonly captures(none) %a) {
  entry:
    %cmp14 = icmp sgt i32 %n, 1
    br i1 %cmp14, label %for.body.preheader, label %for.cond.cleanup

  for.body.preheader:                               ; preds = %entry
    %wide.trip.count = zext i32 %n to i64
    br label %for.body

  for.cond.cleanup:                                 ; preds = %for.body, %entry
    %t.0.lcssa = phi i32 [ 0, %entry ], [ %i.0.t.0, %for.body ]
    ret i32 %t.0.lcssa

  for.body:                                         ; preds = %for.body, %for.body.preheader
    %indvars.iv = phi i64 [ %indvars.iv.next, %for.body ], [ 1, %for.body.preheader ]
    %t.015 = phi i32 [ %i.0.t.0, %for.body ], [ 0, %for.body.preheader ]
    %0 = shl nuw nsw i64 %indvars.iv, 2
    %scevgep = getelementptr i8, ptr %a, i64 %0
    %1 = load i32, ptr %scevgep, align 4
    %idxprom1 = sext i32 %t.015 to i64
    %arrayidx2 = getelementptr inbounds i32, ptr %a, i64 %idxprom1
    %2 = load i32, ptr %arrayidx2, align 4
    %cmp3 = icmp sgt i32 %1, %2
    %tmp = trunc i64 %indvars.iv to i32
    %i.0.t.0 = select i1 %cmp3, i32 %tmp, i32 %t.015
    %indvars.iv.next = add nuw nsw i64 %indvars.iv, 1
    %exitcond = icmp eq i64 %wide.trip.count, %indvars.iv.next
    br i1 %exitcond, label %for.cond.cleanup, label %for.body
  }
...
---
name:            MaxIndex
alignment:       1
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
debugInstrRef:   true
usesBlockArgs:   true
registers:
  - { id: 0, class: gr64 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr64_nosp }
  - { id: 3, class: gr32 }
  - { id: 4, class: gr32 }
  - { id: 5, class: gr64 }
  - { id: 6, class: gr32 }
  - { id: 7, class: gr64 }
  - { id: 8, class: gr32 }
  - { id: 9, class: gr32 }
  - { id: 10, class: gr64 }
  - { id: 11, class: gr32 }
  - { id: 12, class: gr32 }
  - { id: 13, class: gr32 }
  - { id: 14, class: gr64_nosp }
  - { id: 15, class: gr32 }
  - { id: 16, class: gr32 }
  - { id: 17, class: gr64 }
liveins:
  - { reg: '$edi', virtual-reg: '%6' }
  - { reg: '$rsi', virtual-reg: '%7' }
frameInfo:
  maxAlignment:    1
  framePointerPolicy: none
machineFunctionInfo:
  amxProgModel:    None
body:             |
  ; CHECK-LABEL: name: MaxIndex
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $rsi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rsi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   [[SUB32ri:%[0-9]+]]:gr32 = SUB32ri [[COPY1]], 2, implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[MOV32r0_]]
  ; CHECK-NEXT:   JCC_1 %bb.2, 12, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.for.body.preheader:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32rr:%[0-9]+]]:gr32 = MOV32rr [[COPY1]]
  ; CHECK-NEXT:   [[SUBREG_TO_REG:%[0-9]+]]:gr64 = SUBREG_TO_REG [[MOV32rr]], %subreg.sub_32bit
  ; CHECK-NEXT:   [[MOV32r0_1:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   [[MOV32ri64_:%[0-9]+]]:gr64 = MOV32ri64 1
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[MOV32ri64_]], [[MOV32r0_1]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.for.cond.cleanup:
  ; CHECK-NEXT:   arguments: %1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = COPY %1:gr32
  ; CHECK-NEXT:   RET 0, $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.for.body:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT:   arguments: %2, %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32rm:%[0-9]+]]:gr32 = MOV32rm [[COPY]], 4, %2:gr64_nosp, 0, $noreg :: (load (s32) from %ir.scevgep)
  ; CHECK-NEXT:   [[MOVSX64rr32_:%[0-9]+]]:gr64_nosp = MOVSX64rr32 %3:gr32
  ; CHECK-NEXT:   [[SUB32rm:%[0-9]+]]:gr32 = SUB32rm [[MOV32rm]], [[COPY]], 4, [[MOVSX64rr32_]], 0, $noreg, implicit-def $eflags :: (load (s32) from %ir.arrayidx2)
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr32 = COPY %2.sub_32bit:gr64_nosp
  ; CHECK-NEXT:   SUCC_ARGS %bb.5, [[COPY2]]
  ; CHECK-NEXT:   JCC_1 %bb.5, 15, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4.for.body:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.5, %3:gr32
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5.for.body:
  ; CHECK-NEXT:   successors: %bb.2(0x04000000), %bb.3(0x7c000000)
  ; CHECK-NEXT:   arguments: %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[INC64r:%[0-9]+]]:gr64 = nuw nsw INC64r %2:gr64_nosp, implicit-def dead $eflags
  ; CHECK-NEXT:   [[SUB64rr:%[0-9]+]]:gr64 = SUB64rr [[SUBREG_TO_REG]], [[INC64r]], implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, %4:gr32
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[INC64r]], %4:gr32
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  bb.0.entry:
    successors: %bb.1, %bb.2
    liveins: $edi, $rsi

    %7:gr64 = COPY $rsi
    %6:gr32 = COPY $edi
    %8:gr32 = MOV32r0 implicit-def dead $eflags
    %9:gr32 = SUB32ri %6, 2, implicit-def $eflags
    SUCC_ARGS %bb.2, %8
    JCC_1 %bb.2, 12, implicit $eflags
    JMP_1 %bb.1

  bb.1.for.body.preheader:
    %12:gr32 = MOV32rr %6
    %0:gr64 = SUBREG_TO_REG %12, %subreg.sub_32bit
    %11:gr32 = MOV32r0 implicit-def dead $eflags
    %10:gr64 = MOV32ri64 1
    SUCC_ARGS %bb.3, %10, %11
    JMP_1 %bb.3

  bb.2.for.cond.cleanup:
    arguments: %1

    $eax = COPY %1:gr32
    RET 0, $eax

  bb.3.for.body:
    successors: %bb.2(0x04000000), %bb.3(0x7c000000)
    arguments: %2, %3

    %13:gr32 = MOV32rm %7, 4, %2:gr64_nosp, 0, $noreg :: (load (s32) from %ir.scevgep)
    %14:gr64_nosp = MOVSX64rr32 %3:gr32
    %15:gr32 = SUB32rm %13, %7, 4, %14, 0, $noreg, implicit-def $eflags :: (load (s32) from %ir.arrayidx2)
    %16:gr32 = COPY %2.sub_32bit:gr64_nosp
    %4:gr32 = CMOV32rr %3:gr32, %16, 15, implicit $eflags
    %5:gr64 = nuw nsw INC64r %2:gr64_nosp, implicit-def dead $eflags
    %17:gr64 = SUB64rr %0, %5, implicit-def $eflags
    SUCC_ARGS %bb.2, %4
    SUCC_ARGS %bb.3, %5, %4
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.3
...
