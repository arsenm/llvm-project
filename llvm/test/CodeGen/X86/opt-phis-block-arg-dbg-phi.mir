# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=opt-phis -o - %s | FileCheck %s

# Folding a block argument that only receives one value removes the argument.
# Its DBG_PHI must go with it rather than be rewritten to read that value.

---
name: dbg_phi_single_value_arg
tracksRegLiveness: true
usesBlockArgs: true
debugInstrRef: true
body: |
  ; CHECK-LABEL: name: dbg_phi_single_value_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $eax = COPY [[COPY]]
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1
    liveins: $edi
    %0:gr32 = COPY $edi
    SUCC_ARGS %bb.1, %0
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    arguments: %1:gr32
    DBG_PHI %1, 1
    TEST32rr %1, %1, implicit-def $eflags
    SUCC_ARGS %bb.1, %1
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %1
    RET64 implicit $eax
...
