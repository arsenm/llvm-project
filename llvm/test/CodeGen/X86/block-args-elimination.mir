# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=phi-node-elimination -o - %s | FileCheck %s
# Block arguments are lowered to copies by PHI elimination, without ever
# forming a PHI.

# Single argument, single predecessor.
---
name: single
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: single
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 7
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY [[COPY]]
  ; CHECK-NEXT:   RET64 [[COPY1]]
  bb.0:
    successors: %bb.1
    %0:gr32 = MOV32ri 7
    SUCC_ARGS %bb.1, %0
    JMP_1 %bb.1

  bb.1:
    arguments: %1:gr32
    RET64 %1
...

# Two arguments fed positionally from two predecessors.
---
name: two_args_two_preds
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: two_args_two_preds
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; CHECK-NEXT:   [[MOV32ri1:%[0-9]+]]:gr32 = MOV32ri 2
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY [[MOV32ri1]]
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit undef $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri2:%[0-9]+]]:gr32 = MOV32ri 3
  ; CHECK-NEXT:   [[MOV32ri3:%[0-9]+]]:gr32 = MOV32ri 4
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri2]]
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY [[MOV32ri3]]
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr32 = COPY [[COPY]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr32 = COPY [[COPY1]]
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr [[COPY2]], [[COPY3]], implicit-def dead $eflags
  ; CHECK-NEXT:   RET64 [[ADD32rr]]
  bb.0:
    successors: %bb.1, %bb.2
    %0:gr32 = MOV32ri 1
    %1:gr32 = MOV32ri 2
    SUCC_ARGS %bb.2, %0, %1
    JCC_1 %bb.2, 4, implicit undef $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    %2:gr32 = MOV32ri 3
    %3:gr32 = MOV32ri 4
    SUCC_ARGS %bb.2, %2, %3
    JMP_1 %bb.2

  bb.2:
    arguments: %4:gr32, %5:gr32
    %6:gr32 = ADD32rr %4, %5, implicit-def dead $eflags
    RET64 %6
...

# Loop header argument fed from the entry edge and the latch back-edge.
---
name: loop_header
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: loop_header
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY [[COPY]]
  ; CHECK-NEXT:   [[ADD32ri:%[0-9]+]]:gr32 = ADD32ri [[COPY1]], 1, implicit-def dead $eflags
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[ADD32ri]]
  ; CHECK-NEXT:   JCC_1 %bb.1, 4, implicit undef $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET64 [[COPY1]]
  bb.0:
    successors: %bb.1
    %0:gr32 = MOV32ri 0
    SUCC_ARGS %bb.1, %0
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    arguments: %1:gr32
    %2:gr32 = ADD32ri %1, 1, implicit-def dead $eflags
    SUCC_ARGS %bb.1, %2
    JCC_1 %bb.1, 4, implicit undef $eflags
    JMP_1 %bb.2

  bb.2:
    RET64 %1
...

# Critical edge: bb.0 -> bb.2 is critical (bb.0 has two successors, bb.2 has
# two predecessors).
---
name: critical_edge
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: critical_edge
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit undef $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri1:%[0-9]+]]:gr32 = MOV32ri 2
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY [[MOV32ri1]]
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY [[COPY]]
  ; CHECK-NEXT:   RET64 [[COPY1]]
  bb.0:
    successors: %bb.1, %bb.2
    %0:gr32 = MOV32ri 1
    SUCC_ARGS %bb.2, %0
    JCC_1 %bb.2, 4, implicit undef $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    %1:gr32 = MOV32ri 2
    SUCC_ARGS %bb.2, %1
    JMP_1 %bb.2

  bb.2:
    arguments: %2:gr32
    RET64 %2
...
