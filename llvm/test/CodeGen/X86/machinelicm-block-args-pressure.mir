# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-machinelicm -o - %s | FileCheck %s

# The block arguments of %bb.2 add to the register pressure of the blocks it
# dominates like PHI defs would, so the IMUL is not hoisted out of %bb.4.

---
name: licm_pressure
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: licm_pressure
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $edi, $esi, $rdx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY $rdx
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32rm:%[0-9]+]]:gr32 = MOV32rm [[COPY2]], 1, $noreg, 0, $noreg
  ; CHECK-NEXT:   [[MOV32rm1:%[0-9]+]]:gr32 = MOV32rm [[COPY2]], 1, $noreg, 4, $noreg
  ; CHECK-NEXT:   [[MOV32rm2:%[0-9]+]]:gr32 = MOV32rm [[COPY2]], 1, $noreg, 8, $noreg
  ; CHECK-NEXT:   [[MOV32rm3:%[0-9]+]]:gr32 = MOV32rm [[COPY2]], 1, $noreg, 12, $noreg
  ; CHECK-NEXT:   [[MOV32rm4:%[0-9]+]]:gr32 = MOV32rm [[COPY2]], 1, $noreg, 16, $noreg
  ; CHECK-NEXT:   [[MOV32rm5:%[0-9]+]]:gr32 = MOV32rm [[COPY2]], 1, $noreg, 20, $noreg
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[MOV32rm]], [[MOV32rm1]], [[MOV32rm2]], [[MOV32rm3]], [[MOV32rm4]], [[MOV32rm5]]
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   arguments: %9, %10, %11, %12, %13, %14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[IMUL32rr:%[0-9]+]]:gr32 = IMUL32rr [[COPY]], [[COPY1]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr %9:gr32, [[IMUL32rr]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD32rr1:%[0-9]+]]:gr32 = ADD32rr %10:gr32, [[ADD32rr]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD32rr2:%[0-9]+]]:gr32 = ADD32rr %11:gr32, [[ADD32rr1]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD32rr3:%[0-9]+]]:gr32 = ADD32rr %12:gr32, [[ADD32rr2]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD32rr4:%[0-9]+]]:gr32 = ADD32rr %13:gr32, [[ADD32rr3]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD32rr5:%[0-9]+]]:gr32 = ADD32rr %14:gr32, [[ADD32rr4]], implicit-def dead $eflags
  ; CHECK-NEXT:   TEST32rr [[ADD32rr5]], [[ADD32rr5]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   [[ADD32rr6:%[0-9]+]]:gr32 = ADD32rr [[COPY]], [[COPY1]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD32rr7:%[0-9]+]]:gr32 = ADD32rr [[ADD32rr6]], [[ADD32rr5]], implicit-def dead $eflags
  ; CHECK-NEXT:   $eax = COPY [[ADD32rr7]]
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1
    liveins: $edi, $esi, $rdx
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %2:gr64 = COPY $rdx
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    %10:gr32 = MOV32rm %2, 1, $noreg, 0, $noreg
    %11:gr32 = MOV32rm %2, 1, $noreg, 4, $noreg
    %12:gr32 = MOV32rm %2, 1, $noreg, 8, $noreg
    %13:gr32 = MOV32rm %2, 1, $noreg, 12, $noreg
    %14:gr32 = MOV32rm %2, 1, $noreg, 16, $noreg
    %15:gr32 = MOV32rm %2, 1, $noreg, 20, $noreg
    SUCC_ARGS %bb.2, %10, %11, %12, %13, %14, %15
    JMP_1 %bb.2

  bb.2:
    successors: %bb.4
    arguments: %100:gr32, %101:gr32, %102:gr32, %103:gr32, %104:gr32, %105:gr32
    JMP_1 %bb.4

  bb.4:
    successors: %bb.1, %bb.3
    %3:gr32 = IMUL32rr %0, %1, implicit-def dead $eflags
    %200:gr32 = ADD32rr %100, %3, implicit-def dead $eflags
    %201:gr32 = ADD32rr %101, %200, implicit-def dead $eflags
    %202:gr32 = ADD32rr %102, %201, implicit-def dead $eflags
    %203:gr32 = ADD32rr %103, %202, implicit-def dead $eflags
    %204:gr32 = ADD32rr %104, %203, implicit-def dead $eflags
    %205:gr32 = ADD32rr %105, %204, implicit-def dead $eflags
    TEST32rr %205, %205, implicit-def $eflags
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.3

  bb.3:
    %4:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    %5:gr32 = ADD32rr %4, %205, implicit-def dead $eflags
    $eax = COPY %5
    RET64 implicit $eax
...

