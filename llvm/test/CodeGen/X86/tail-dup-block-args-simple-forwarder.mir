# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-tailduplication -o - %s | FileCheck %s

# bb.1 only forwards a value to its successor's block argument, so it is still a
# simple block and is bypassed, moving the SUCC_ARGS into bb.0.

---
name: simple_forwarder
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: simple_forwarder
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[COPY]]
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr [[COPY]], [[COPY1]], implicit-def dead $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[ADD32rr]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $eax = COPY %3:gr32
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3
    SUCC_ARGS %bb.3, %0
    JMP_1 %bb.3

  bb.2:
    successors: %bb.3
    %2:gr32 = ADD32rr %0, %1, implicit-def dead $eflags
    SUCC_ARGS %bb.3, %2
    JMP_1 %bb.3

  bb.3:
    arguments: %3:gr32
    $eax = COPY %3
    RET64 implicit $eax
...
