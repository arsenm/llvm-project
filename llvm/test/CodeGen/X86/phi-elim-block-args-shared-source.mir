# RUN: llc -mtriple=x86_64-- -passes='require<live-intervals>,phi-node-elimination,print<live-intervals>' -o /dev/null %s 2>&1 | FileCheck %s

# %2 is forwarded by both SUCC_ARGS in bb.1. Lowering the back edge must keep
# %2 live up to the SUCC_ARGS for bb.2, which is lowered afterwards.

# CHECK: {{^}}%2 [{{[0-9]+}}r,[[END:[0-9]+]]r:0) 0@{{[0-9]+}}r
# CHECK: [[END]]B{{.*}}= COPY %2
# CHECK-NOT: COPY %2

---
name: shared_source
tracksRegLiveness: true
usesBlockArgs: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $edi
    %0:gr32 = COPY $edi
    SUCC_ARGS %bb.1, %0
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.1
    arguments: %1:gr32
    %2:gr32 = DEC32r %1, implicit-def $eflags
    SUCC_ARGS %bb.2, %2
    SUCC_ARGS %bb.1, %2
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    arguments: %3:gr32
    $eax = COPY %3
    RET64 implicit $eax
...
