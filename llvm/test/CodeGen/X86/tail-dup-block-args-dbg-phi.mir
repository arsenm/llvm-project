# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-tailduplication -o - %s | FileCheck %s

# A DBG_PHI of a block argument must not be cloned into the predecessors when
# its block is tail duplicated. The clone would read the forwarded value, a
# debug-only virtual register that PHI elimination never converts, and it
# would survive register allocation.

---
name: dbg_phi_block_arg
tracksRegLiveness: true
usesBlockArgs: true
debugInstrRef: true
body: |
  ; CHECK-LABEL: name: dbg_phi_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 7
  ; CHECK-NEXT:   [[SUBREG_TO_REG:%[0-9]+]]:gr64 = SUBREG_TO_REG [[MOV32ri]], %subreg.sub_32bit
  ; CHECK-NEXT:   JMP64r [[SUBREG_TO_REG]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[SUBREG_TO_REG1:%[0-9]+]]:gr64 = SUBREG_TO_REG [[COPY]], %subreg.sub_32bit
  ; CHECK-NEXT:   JMP64r [[SUBREG_TO_REG1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   RET64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3
    %1:gr32 = MOV32ri 7
    SUCC_ARGS %bb.3, %1
    JMP_1 %bb.3

  bb.2:
    successors: %bb.3
    SUCC_ARGS %bb.3, %0
    JMP_1 %bb.3

  bb.3:
    successors: %bb.4, %bb.5
    arguments: %2:gr32
    DBG_PHI %2, 1
    %3:gr64 = SUBREG_TO_REG %2, %subreg.sub_32bit
    JMP64r %3

  bb.4:
    RET64

  bb.5:
    RET64
...
