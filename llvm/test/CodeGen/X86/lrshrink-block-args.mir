# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=lrshrink -o - %s | FileCheck %s

# Block arguments are defined at the start of their block, like PHIs, so an
# instruction whose operands are single-use block arguments is hoisted there.

---
name: hoist_to_block_start
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: hoist_to_block_start
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY]], [[COPY1]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2, %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr %2:gr32, %3:gr32, implicit-def dead $eflags
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; CHECK-NEXT:   [[MOV32ri1:%[0-9]+]]:gr32 = MOV32ri 2
  ; CHECK-NEXT:   [[ADD32rr1:%[0-9]+]]:gr32 = ADD32rr [[MOV32ri]], [[MOV32ri1]], implicit-def dead $eflags
  ; CHECK-NEXT:   [[ADD32rr2:%[0-9]+]]:gr32 = ADD32rr [[ADD32rr]], [[ADD32rr1]], implicit-def dead $eflags
  ; CHECK-NEXT:   $eax = COPY [[ADD32rr2]]
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    SUCC_ARGS %bb.1, %0, %1
    JMP_1 %bb.1

  bb.1:
    arguments: %2:gr32, %3:gr32
    %4:gr32 = MOV32ri 1
    %5:gr32 = MOV32ri 2
    %6:gr32 = ADD32rr %2, %3, implicit-def dead $eflags
    %7:gr32 = ADD32rr %4, %5, implicit-def dead $eflags
    %8:gr32 = ADD32rr %6, %7, implicit-def dead $eflags
    $eax = COPY %8
    RET64 implicit $eax
...

# Hoisting to the block start would move the dead $eflags def above its reader.

---
name: dead_def_read_in_block
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: dead_def_read_in_block
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY]], [[COPY1]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2, %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; CHECK-NEXT:   TEST32rr [[MOV32ri]], [[MOV32ri]], implicit-def $eflags
  ; CHECK-NEXT:   [[SETCCr:%[0-9]+]]:gr8 = SETCCr 4, implicit $eflags
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr %2:gr32, %3:gr32, implicit-def dead $eflags
  ; CHECK-NEXT:   [[MOVZX32rr8_:%[0-9]+]]:gr32 = MOVZX32rr8 [[SETCCr]]
  ; CHECK-NEXT:   [[ADD32rr1:%[0-9]+]]:gr32 = ADD32rr [[ADD32rr]], [[MOVZX32rr8_]], implicit-def dead $eflags
  ; CHECK-NEXT:   $eax = COPY [[ADD32rr1]]
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    SUCC_ARGS %bb.1, %0, %1
    JMP_1 %bb.1

  bb.1:
    arguments: %2:gr32, %3:gr32
    %4:gr32 = MOV32ri 1
    TEST32rr %4, %4, implicit-def $eflags
    %5:gr8 = SETCCr 4, implicit $eflags
    %6:gr32 = ADD32rr %2, %3, implicit-def dead $eflags
    %7:gr32 = MOVZX32rr8 %5
    %8:gr32 = ADD32rr %6, %7, implicit-def dead $eflags
    $eax = COPY %8
    RET64 implicit $eax
...
