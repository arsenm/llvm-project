# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=phi-node-elimination -o - %s | FileCheck -check-prefix=NOLIS %s
# RUN: llc -mtriple=x86_64-- -run-pass=liveintervals,phi-node-elimination -o - %s | FileCheck -check-prefix=LIS %s

# finalizeDebugInstrRefs records a debug value that flows through copies into a
# block argument with a DBG_PHI, since the argument has no defining instruction.
# PHI elimination must convert that DBG_PHI into a DebugPHIPositions entry and
# erase it when it lowers the block argument to copies; a leftover DBG_PHI would
# keep a debug-only virtual register alive past register allocation.

# CHECK-LABEL: name: dbg_phi_block_arg
# CHECK-NOT:   DBG_PHI
---
name: dbg_phi_block_arg
tracksRegLiveness: true
usesBlockArgs: true
debugInstrRef: true
body: |
  ; NOLIS-LABEL: name: dbg_phi_block_arg
  ; NOLIS: bb.0:
  ; NOLIS-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; NOLIS-NEXT:   liveins: $edi
  ; NOLIS-NEXT: {{  $}}
  ; NOLIS-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY killed $edi
  ; NOLIS-NEXT:   [[COPY1:%[0-9]+]]:gr8 = COPY killed [[COPY]].sub_8bit
  ; NOLIS-NEXT:   [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; NOLIS-NEXT:   TEST8ri killed [[COPY1]], 1, implicit-def $eflags
  ; NOLIS-NEXT:   [[COPY2:%[0-9]+]]:gr32 = COPY [[MOV32r0_]]
  ; NOLIS-NEXT:   JCC_1 %bb.2, 5, implicit killed $eflags
  ; NOLIS-NEXT:   JMP_1 %bb.1
  ; NOLIS-NEXT: {{  $}}
  ; NOLIS-NEXT: bb.1:
  ; NOLIS-NEXT:   successors: %bb.2(0x80000000)
  ; NOLIS-NEXT: {{  $}}
  ; NOLIS-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; NOLIS-NEXT:   [[COPY2:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
  ; NOLIS-NEXT: {{  $}}
  ; NOLIS-NEXT: bb.2:
  ; NOLIS-NEXT:   [[COPY3:%[0-9]+]]:gr32 = COPY [[COPY2]]
  ; NOLIS-NEXT:   [[MOV32rr:%[0-9]+]]:gr32 = MOV32rr [[COPY3]]
  ; NOLIS-NEXT:   $eax = COPY killed [[MOV32rr]]
  ; NOLIS-NEXT:   RET 0, $eax
  ;
  ; LIS-LABEL: name: dbg_phi_block_arg
  ; LIS: bb.0:
  ; LIS-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; LIS-NEXT:   liveins: $edi
  ; LIS-NEXT: {{  $}}
  ; LIS-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; LIS-NEXT:   [[COPY1:%[0-9]+]]:gr8 = COPY [[COPY]].sub_8bit
  ; LIS-NEXT:   [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; LIS-NEXT:   TEST8ri [[COPY1]], 1, implicit-def $eflags
  ; LIS-NEXT:   [[COPY2:%[0-9]+]]:gr32 = COPY [[MOV32r0_]]
  ; LIS-NEXT:   JCC_1 %bb.2, 5, implicit killed $eflags
  ; LIS-NEXT:   JMP_1 %bb.1
  ; LIS-NEXT: {{  $}}
  ; LIS-NEXT: bb.1:
  ; LIS-NEXT:   successors: %bb.2(0x80000000)
  ; LIS-NEXT: {{  $}}
  ; LIS-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; LIS-NEXT:   [[COPY2:%[0-9]+]]:gr32 = COPY [[MOV32ri]]
  ; LIS-NEXT: {{  $}}
  ; LIS-NEXT: bb.2:
  ; LIS-NEXT:   [[COPY3:%[0-9]+]]:gr32 = COPY [[COPY2]]
  ; LIS-NEXT:   [[MOV32rr:%[0-9]+]]:gr32 = MOV32rr [[COPY3]]
  ; LIS-NEXT:   $eax = COPY [[MOV32rr]]
  ; LIS-NEXT:   RET 0, $eax
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $edi
    %1:gr32 = COPY killed $edi
    %3:gr8 = COPY killed %1.sub_8bit
    %2:gr32 = MOV32r0 implicit-def dead $eflags
    TEST8ri killed %3, 1, implicit-def $eflags
    SUCC_ARGS %bb.2, killed %2
    JCC_1 %bb.2, 5, implicit killed $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    %4:gr32 = MOV32ri 1
    SUCC_ARGS %bb.2, killed %4

  bb.2:
    arguments: %0:gr32
    DBG_PHI %0:gr32, 1
    %5:gr32 = MOV32rr %0:gr32
    $eax = COPY killed %5
    RET 0, $eax
...
