# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=liveintervals,phi-node-elimination -o - %s | FileCheck %s

# Every incoming edge of %bb.3 and %bb.4 is critical and both receive the same
# values from the same predecessors, so like identical PHIs they share one copy
# in each predecessor.

---
name: reuse_incoming
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: reuse_incoming
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $esi, $edx
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr32 = COPY $edx
  ; CHECK-NEXT:   TEST32rr [[COPY2]], [[COPY2]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr32 = COPY [[COPY]]
  ; CHECK-NEXT:   JCC_1 %bb.4, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   TEST32rr [[COPY1]], [[COPY1]], implicit-def $eflags
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr32 = COPY [[COPY1]]
  ; CHECK-NEXT:   JCC_1 %bb.4, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gr32 = COPY [[COPY3]]
  ; CHECK-NEXT:   $eax = COPY [[COPY4]]
  ; CHECK-NEXT:   RET64 implicit $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   [[COPY5:%[0-9]+]]:gr32 = COPY [[COPY3]]
  ; CHECK-NEXT:   [[INC32r:%[0-9]+]]:gr32 = INC32r [[COPY5]], implicit-def dead $eflags
  ; CHECK-NEXT:   $eax = COPY [[INC32r]]
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi, $esi, $edx
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    %5:gr32 = COPY $edx
    TEST32rr %5, %5, implicit-def $eflags
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3, %bb.4
    TEST32rr %0, %0, implicit-def $eflags
    SUCC_ARGS %bb.3, %0
    SUCC_ARGS %bb.4, %0
    JCC_1 %bb.4, 4, implicit $eflags
    JMP_1 %bb.3

  bb.2:
    successors: %bb.3, %bb.4
    TEST32rr %1, %1, implicit-def $eflags
    SUCC_ARGS %bb.3, %1
    SUCC_ARGS %bb.4, %1
    JCC_1 %bb.4, 4, implicit $eflags
    JMP_1 %bb.3

  bb.3:
    arguments: %2:gr32
    $eax = COPY %2
    RET64 implicit $eax

  bb.4:
    arguments: %3:gr32
    %4:gr32 = INC32r %3, implicit-def dead $eflags
    $eax = COPY %4
    RET64 implicit $eax
...
