# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-machinelicm -o - %s | FileCheck %s

# A cheap instruction forwarded to a block argument of the loop is not hoisted,
# like one used by a PHI in the loop: hoisting it would extend its live range
# across the loop and require a copy.

---
name: succ_args_loop_use
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: succ_args_loop_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY]], [[MOV32r0_]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   arguments: %2, %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 7
  ; CHECK-NEXT:   [[DEC32r:%[0-9]+]]:gr32 = DEC32r %2:gr32, implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[DEC32r]], [[MOV32ri]]
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $eax = COPY %3:gr32
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = MOV32r0 implicit-def dead $eflags
    SUCC_ARGS %bb.1, %0, %1
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    arguments: %2:gr32, %3:gr32
    %4:gr32 = MOV32ri 7
    %5:gr32 = DEC32r %2, implicit-def $eflags
    SUCC_ARGS %bb.1, %5, %4
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %3
    RET64 implicit $eax
...
