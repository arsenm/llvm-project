# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-machinelicm -o - %s | FileCheck %s

# MachineLICM splits the critical edge bb.0 -> bb.1 to form a loop preheader.
# The SUCC_ARGS forwarding a value to bb.1's block argument on that edge must
# move into the new block rather than stay in bb.0.
---
name: split_critical_edge_succ_args
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: split_critical_edge_succ_args
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.4(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY $esi
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.2, 5, implicit $eflags
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   arguments: %2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr [[COPY]], [[COPY1]], implicit-def $eflags
  ; CHECK-NEXT:   TEST32rr [[ADD32rr]], [[ADD32rr]], implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[ADD32rr]]
  ; CHECK-NEXT:   JCC_1 %bb.1, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   RET64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $eax = COPY %2:gr32
  ; CHECK-NEXT:   RET64 $eax
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    TEST32rr %0, %0, implicit-def $eflags
    SUCC_ARGS %bb.1, %1
    JCC_1 %bb.2, 5, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.3
    arguments: %2:gr32
    %3:gr32 = ADD32rr %0, %1, implicit-def $eflags
    TEST32rr %3, %3, implicit-def $eflags
    SUCC_ARGS %bb.1, %3
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.3

  bb.2:
    RET64

  bb.3:
    $eax = COPY %2
    RET64 $eax
...
