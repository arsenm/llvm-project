# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=liveintervals,phi-node-elimination -o - %s | FileCheck %s

# %1 is defined at the start of %bb.1, but like a PHI def it is not live into
# %bb.1 through the back edge, so forwarding it to %bb.2 does not make it live
# out past the edge and the critical edge %bb.1 -> %bb.2 is not split.

---
name: self_loop_arg_to_exit
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: self_loop_arg_to_exit
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $rdi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr64 = COPY $rdi
  ; CHECK-NEXT:   TEST64rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[COPY]]
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY [[COPY]]
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr64 = COPY [[COPY1]]
  ; CHECK-NEXT:   [[MOV64rm:%[0-9]+]]:gr64 = MOV64rm [[COPY3]], 1, $noreg, 0, $noreg
  ; CHECK-NEXT:   TEST64rr [[MOV64rm]], [[MOV64rm]], implicit-def $eflags
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr64 = COPY [[MOV64rm]]
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr64 = COPY [[COPY3]]
  ; CHECK-NEXT:   JCC_1 %bb.2, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gr64 = COPY [[COPY2]]
  ; CHECK-NEXT:   $rax = COPY [[COPY4]]
  ; CHECK-NEXT:   RET64 implicit $rax
  bb.0:
    successors: %bb.2, %bb.1
    liveins: $rdi
    %0:gr64 = COPY $rdi
    TEST64rr %0, %0, implicit-def $eflags
    SUCC_ARGS %bb.2, %0
    SUCC_ARGS %bb.1, %0
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2, %bb.1
    arguments: %1:gr64
    %2:gr64 = MOV64rm %1, 1, $noreg, 0, $noreg
    TEST64rr %2, %2, implicit-def $eflags
    SUCC_ARGS %bb.2, %1
    SUCC_ARGS %bb.1, %2
    JCC_1 %bb.2, 4, implicit $eflags
    JMP_1 %bb.1

  bb.2:
    arguments: %3:gr64
    $rax = COPY %3
    RET64 implicit $rax
...
