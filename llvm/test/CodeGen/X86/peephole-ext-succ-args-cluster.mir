# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=peephole-opt -sdag-use-block-args -verify-machineinstrs %s -o - | FileCheck %s

# optimizeExtInstr does not reuse the MOVSX64rr32 result for the SUCC_ARGS use of
# %0, like a PHI use.
---
name: reuse_ext_before_succ_args_cluster
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: reuse_ext_before_succ_args_cluster
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:gr64 = IMPLICIT_DEF
  ; CHECK-NEXT:   [[MOVSX64rr32_:%[0-9]+]]:gr64_nosp = MOVSX64rr32 [[COPY]]
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[DEF]]
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY]]
  ; CHECK-NEXT:   JMP64m [[MOVSX64rr32_]], 1, $noreg, 0, $noreg
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   RET 0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr64 = IMPLICIT_DEF
    %2:gr64_nosp = MOVSX64rr32 %0
    SUCC_ARGS %bb.2, %1
    SUCC_ARGS %bb.1, %0
    JMP64m %2, 1, $noreg, 0, $noreg

  bb.1:
    arguments: %10:gr32
    RET 0

  bb.2:
    arguments: %11:gr64
    RET 0
...
