# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=dead-mi-elimination -o - %s | FileCheck %s

# A block argument whose only use is a DBG_PHI is dead. Deleting it must also
# delete the DBG_PHI, which would otherwise read a register with no definition.

---
name: dbg_phi_dead_block_arg
tracksRegLiveness: true
usesBlockArgs: true
debugInstrRef: true
body: |
  ; CHECK-LABEL: name: dbg_phi_dead_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.1
    liveins: $edi
    %0:gr32 = COPY $edi
    SUCC_ARGS %bb.1, %0
    JMP_1 %bb.1

  bb.1:
    arguments: %1:gr32
    DBG_PHI %1, 1
    RET64
...
