# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-tailduplication -tail-dup-pred-size=2 -tail-dup-succ-size=2 -o - %s | FileCheck %s

# bb.3 is a "simple" block (single unconditional branch) that carries a block
# argument %10 forwarded onward and used by a real instruction in its successor
# bb.4. The simple tail-duplication bypass must not be applied here: bypassing
# bb.3 would delete the only definition point of %10 (its block-argument
# declaration), leaving bb.4's use of %10 without a reaching definition. Such a
# block is routed through the general path, which reconciles the argument with
# SSAUpdater.
---
name: f
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: f
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.5(0x40000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   TEST32rr [[COPY]], [[COPY]], implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.5, [[COPY]]
  ; CHECK-NEXT:   JCC_1 %bb.5, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.5(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 7
  ; CHECK-NEXT:   SUCC_ARGS %bb.5, [[MOV32ri]]
  ; CHECK-NEXT:   JMP_1 %bb.5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr %3:gr32, %3:gr32, implicit-def $eflags
  ; CHECK-NEXT:   TEST32rr [[ADD32rr]], [[ADD32rr]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.4, 4, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $eax = COPY [[ADD32rr]]
  ; CHECK-NEXT:   RET64 implicit $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   $eax = COPY %3:gr32
  ; CHECK-NEXT:   RET64 implicit $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   JMP_1 %bb.2
  bb.0:
    successors: %bb.1, %bb.3
    liveins: $edi
    %0:gr32 = COPY $edi
    TEST32rr %0, %0, implicit-def $eflags
    SUCC_ARGS %bb.3, %0
    JCC_1 %bb.3, 4, implicit $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.3
    %1:gr32 = MOV32ri 7
    SUCC_ARGS %bb.3, %1
    JMP_1 %bb.3

  bb.4:
    successors: %bb.5, %bb.6
    %11:gr32 = ADD32rr %10, %10, implicit-def $eflags
    TEST32rr %11, %11, implicit-def $eflags
    JCC_1 %bb.6, 4, implicit $eflags
    JMP_1 %bb.5

  bb.5:
    $eax = COPY %11
    RET64 implicit $eax

  bb.6:
    $eax = COPY %10
    RET64 implicit $eax

  bb.3:
    successors: %bb.4
    arguments: %10:gr32
    JMP_1 %bb.4
...
