# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=peephole-opt -o - %s | FileCheck %s

# There is a recurrence formed by the loop header block argument %2 and %3.
# The ADD is commuted so %2 is the tied operand, like for a loop header PHI.

---
name: block_arg_recurrence
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: block_arg_recurrence
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[MOV32r0_:%[0-9]+]]:gr32 = MOV32r0 implicit-def dead $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[MOV32r0_]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   arguments: %2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD32rr:%[0-9]+]]:gr32 = ADD32rr %2:gr32, [[COPY]], implicit-def dead $eflags
  ; CHECK-NEXT:   CMP32ri [[ADD32rr]], 10, implicit-def $eflags
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[ADD32rr]]
  ; CHECK-NEXT:   JCC_1 %bb.1, 12, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $eax = COPY [[ADD32rr]]
  ; CHECK-NEXT:   RET64 implicit $eax
  bb.0:
    successors: %bb.1
    liveins: $edi
    %0:gr32 = COPY $edi
    %1:gr32 = MOV32r0 implicit-def dead $eflags
    SUCC_ARGS %bb.1, %1
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    arguments: %2:gr32
    %3:gr32 = ADD32rr %0, %2, implicit-def dead $eflags
    CMP32ri %3, 10, implicit-def $eflags
    SUCC_ARGS %bb.1, %3
    JCC_1 %bb.1, 12, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %3
    RET64 implicit $eax
...
