# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=early-tailduplication -tail-dup-pred-size=1 -tail-dup-succ-size=1 -o - %s | FileCheck %s

# bb.4 has multiple predecessors and multiple successors and carries a block
# argument. Duplicating it into each predecessor would multiply the SUCC_ARGS
# forwarding just as it would multiply PHIs, so shouldTailDuplicate must reject
# it (the block-argument analogue of the NumPhis guard).
---
name: no_dup_multi_pred_succ_block_args
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: no_dup_multi_pred_succ_block_args
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[COPY]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri:%[0-9]+]]:gr32 = MOV32ri 1
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[MOV32ri]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOV32ri1:%[0-9]+]]:gr32 = MOV32ri 2
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, [[MOV32ri1]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.4(0x2aaaaaab), %bb.5(0x2aaaaaab), %bb.6(0x2aaaaaab)
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY %3:gr32
  ; CHECK-NEXT:   TEST32rr [[COPY1]], [[COPY1]], implicit-def $eflags
  ; CHECK-NEXT:   JCC_1 %bb.5, 4, implicit $eflags
  ; CHECK-NEXT:   JCC_1 %bb.6, 5, implicit $eflags
  ; CHECK-NEXT:   JMP_1 %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   RET64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.5:
  ; CHECK-NEXT:   RET64
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.6:
  ; CHECK-NEXT:   RET64
  bb.0:
    successors: %bb.4
    liveins: $edi
    %0:gr32 = COPY $edi
    SUCC_ARGS %bb.4, %0
    JMP_1 %bb.4

  bb.1:
    successors: %bb.4
    %1:gr32 = MOV32ri 1
    SUCC_ARGS %bb.4, %1
    JMP_1 %bb.4

  bb.2:
    successors: %bb.4
    %2:gr32 = MOV32ri 2
    SUCC_ARGS %bb.4, %2
    JMP_1 %bb.4

  bb.4:
    successors: %bb.5, %bb.6, %bb.7
    arguments: %10:gr32
    %11:gr32 = COPY %10
    TEST32rr %11, %11, implicit-def $eflags
    JCC_1 %bb.6, 4, implicit $eflags
    JCC_1 %bb.7, 5, implicit $eflags
    JMP_1 %bb.5

  bb.5:
    RET64

  bb.6:
    RET64

  bb.7:
    RET64
...
