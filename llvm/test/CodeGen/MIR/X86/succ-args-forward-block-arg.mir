# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=x86_64-- -run-pass=phi-node-elimination -o - %s | FileCheck %s

# A block argument that is itself forwarded as a SUCC_ARGS source must be lowered
# to a real COPY, not an IMPLICIT_DEF. Here %1 is bb.2's block argument and is
# forwarded on to bb.1 via bb.3's SUCC_ARGS. Because the receiver bb.1 is lowered
# before the provider bb.2, %1 has no def yet at that point; it must still be
# recognized as a block-argument value rather than mistaken for an undef value.

---
name: forward_block_arg
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: forward_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $edi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gr32 = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gr32 = COPY [[COPY]]
  ; CHECK-NEXT:   JMP_1 %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gr32 = COPY %3
  ; CHECK-NEXT:   $eax = COPY [[COPY2]]
  ; CHECK-NEXT:   RET64 implicit $eax
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gr32 = COPY [[COPY1]]
  ; CHECK-NEXT:   JMP_1 %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:gr32 = COPY [[COPY3]]
  ; CHECK-NEXT:   JMP_1 %bb.1
  bb.0:
    successors: %bb.2
    liveins: $edi
    %0:gr32 = COPY $edi
    SUCC_ARGS %bb.2, %0
    JMP_1 %bb.2

  bb.1:
    arguments: %2:gr32
    $eax = COPY %2
    RET64 implicit $eax

  bb.2:
    successors: %bb.3
    arguments: %1:gr32
    JMP_1 %bb.3

  ; The forwarded source is bb.2's block argument, so a real COPY must be
  ; materialized here.
  bb.3:
    successors: %bb.1
    SUCC_ARGS %bb.1, %1
    JMP_1 %bb.1
...
