# RUN: llc -mtriple=x86_64-- -run-pass=none -o - %s | FileCheck %s
# Round-trip test for the generic G_SUCC_ARGS pseudo feeding typed block
# arguments.

---
name: f
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: f
  bb.0:
    successors: %bb.1
    %0:_(s32) = G_IMPLICIT_DEF
    %1:_(s32) = G_IMPLICIT_DEF
    ; CHECK: G_SUCC_ARGS %bb.1, %0(s32), %1(s32)
    G_SUCC_ARGS %bb.1, %0, %1
    G_BR %bb.1

  ; CHECK: bb.1:
  ; CHECK: arguments: %2(s32), %3(s32)
  bb.1:
    arguments: %2:_(s32), %3:_(s32)
    RET64
...
