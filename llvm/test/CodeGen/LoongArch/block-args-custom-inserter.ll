; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=loongarch32 -mattr=-32s -sdag-use-block-args < %s | FileCheck %s

; Without 32S, selects are expanded by a custom inserter that merges the
; true/false values in the tail block. Under -sdag-use-block-args those merges
; must be block arguments fed by SUCC_ARGS, not machine PHIs.
define i32 @select_custom_inserter(i32 %c, i32 %a, i32 %b) {
; CHECK-LABEL: select_custom_inserter:
; CHECK:       # %bb.0:
; CHECK-NEXT:    bne $a0, $zero, .LBB0_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    move $a1, $a2
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    move $a0, $a1
; CHECK-NEXT:    ret
  %cmp = icmp ne i32 %c, 0
  %r = select i1 %cmp, i32 %a, i32 %b
  ret i32 %r
}

; A group of selects with the same condition shares one diamond.
define { i32, i32 } @select_group(i32 %c, i32 %a, i32 %b, i32 %d, i32 %e) {
; CHECK-LABEL: select_group:
; CHECK:       # %bb.0:
; CHECK-NEXT:    bne $a0, $zero, .LBB1_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    move $a1, $a2
; CHECK-NEXT:    move $a3, $a4
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    move $a0, $a1
; CHECK-NEXT:    move $a1, $a3
; CHECK-NEXT:    ret
  %cmp = icmp ne i32 %c, 0
  %r1 = select i1 %cmp, i32 %a, i32 %b
  %r2 = select i1 %cmp, i32 %d, i32 %e
  %i1 = insertvalue { i32, i32 } undef, i32 %r1, 0
  %i2 = insertvalue { i32, i32 } %i1, i32 %r2, 1
  ret { i32, i32 } %i2
}
