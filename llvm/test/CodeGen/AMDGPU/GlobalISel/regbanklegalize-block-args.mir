# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=amdgpu-reg-bank-legalize -verify-machineinstrs %s -o - | FileCheck %s

# AMDGPURegBankLegalize handles G_SUCC_ARGS by reconciling each forwarded value
# to its receiver block argument's already-assigned bank, inserting a copy when
# they differ. Operand 0 is the successor block, not a register.

# A forwarded value whose bank already matches the receiver needs no copy.
--- |
  define void @match() { ret void }
  define void @mismatch() { ret void }
  define void @hetero() { ret void }
  define void @widen_uniform_s1() { ret void }
...
---
name:            match
tracksRegLiveness: true
usesBlockArgs:   true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: match
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %1(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr0 = COPY %1:vgpr(s32)
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0

    %0:vgpr(s32) = COPY $vgpr0
    G_SUCC_ARGS %bb.1, %0(s32)
    G_BR %bb.1

  bb.1:
    arguments: %1:vgpr(s32)

    $vgpr0 = COPY %1(s32)
    S_ENDPGM 0
...
---
# The forwarded value is a VGPR but the receiver is an SGPR, so a copy to the
# receiver's bank is inserted before the G_SUCC_ARGS.
name:            mismatch
tracksRegLiveness: true
usesBlockArgs:   true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: mismatch
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr(s32) = COPY [[COPY]](s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY1]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %1(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr0 = COPY %1:sgpr(s32)
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0

    %0:vgpr(s32) = COPY $vgpr0
    G_SUCC_ARGS %bb.1, %0(s32)
    G_BR %bb.1

  bb.1:
    arguments: %1:sgpr(s32)

    $sgpr0 = COPY %1(s32)
    S_ENDPGM 0
...
---
# A single G_SUCC_ARGS forwarding several heterogeneous block arguments: a
# vgpr->sgpr receiver and an sgpr->vgpr receiver both need a copy to the
# receiver's bank, while matching-bank arguments are left unchanged.
name:            hetero
tracksRegLiveness: true
usesBlockArgs:   true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: hetero
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %v:vgpr(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %s:sgpr(s32) = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sgpr(s32) = COPY %v(s32)
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr(s32) = COPY %s(s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY]](s32), [[COPY1]](s32), %v(s32), %s(s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2(s32), %3(s32), %4(s32), %5(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr0 = COPY %a1:vgpr(s32)
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0

    %v:vgpr(s32) = COPY $vgpr0
    %s:sgpr(s32) = COPY $sgpr0
    G_SUCC_ARGS %bb.1, %v(s32), %s(s32), %v(s32), %s(s32)
    G_BR %bb.1

  bb.1:
    arguments: %a0:sgpr(s32), %a1:vgpr(s32), %a2:vgpr(s32), %a3:sgpr(s32)

    $vgpr0 = COPY %a1(s32)
    S_ENDPGM 0
...
---
# A uniform (sgpr) S1 block argument has no G_PHI to trigger the S1->S32
# widening, so AMDGPURegBankLegalize widens the argument list directly: the
# receiver becomes an S32 argument with a trunc back at the block start, and
# each predecessor's forwarded value is anyext'd to S32.
name:            widen_uniform_s1
tracksRegLiveness: true
usesBlockArgs:   true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: widen_uniform_s1
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sgpr(s32) = COPY $sgpr0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %9(i32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C:%[0-9]+]]:sgpr(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[XOR:%[0-9]+]]:sgpr(i32) = G_XOR %9:sgpr, [[C]]
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    liveins: $sgpr0

    %0:sgpr(s32) = COPY $sgpr0
    %1:sgpr(s1) = G_TRUNC %0(s32)
    G_SUCC_ARGS %bb.1, %1(s1)
    G_BR %bb.1

  bb.1:
    arguments: %2:sgpr(s1)

    %3:sgpr(s1) = G_CONSTANT i1 true
    %4:sgpr(s1) = G_XOR %2, %3
    S_ENDPGM 0
...
