# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-prelegalizer-combiner -verify-machineinstrs %s -o - | FileCheck %s

# The brcond-by-inverting-cond combine materializes a constant + xor to invert
# the branch condition. Those are not terminators, so they must be emitted
# before the block's SUCC_ARGS cluster, not at the G_BRCOND (which sits after
# the cluster).
--- |
  define void @invert() { ret void }
...
---
name:            invert
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: invert
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[C]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x04000000), %bb.1(0x7c000000)
  ; CHECK-NEXT:   arguments: %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(s32) = G_ADD %3:_, [[C1]]
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(s1) = G_TRUNC [[COPY]](s32)
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(s1) = G_CONSTANT i1 true
  ; CHECK-NEXT:   [[XOR:%[0-9]+]]:_(s1) = G_XOR [[TRUNC]], [[C2]]
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[ADD]](s32)
  ; CHECK-NEXT:   G_BRCOND [[XOR]](s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $vgpr0 = COPY %3:_(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1

    %0:_(s32) = COPY $vgpr0
    %6:_(s32) = COPY $vgpr1
    %1:_(s32) = G_CONSTANT i32 0
    G_SUCC_ARGS %bb.1, %1(s32)
    G_BR %bb.1

  bb.1:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    arguments: %2:_(s32)

    %3:_(s32) = G_CONSTANT i32 1
    %4:_(s32) = G_ADD %2, %3
    %5:_(s1) = G_TRUNC %6(s32)
    G_SUCC_ARGS %bb.1, %4(s32)
    G_BRCOND %5(s1), %bb.2
    G_BR %bb.1

  bb.2:
    $vgpr0 = COPY %2(s32)
    SI_RETURN implicit $vgpr0
...
