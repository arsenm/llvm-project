# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=instruction-select %s -o - | FileCheck %s

# Make sure selection works with block arguments and new terminators
# are correctly placed.
---
name:            sel_brcond
legalized:       true
regBankSelected: true
tracksRegLiveness: true
usesBlockArgs:   true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: sel_brcond
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
  ; CHECK-NEXT:   $scc = COPY [[COPY]]
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[COPY1]]
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   S_ENDPGM 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr0 = COPY %a:sreg_32
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr0, $sgpr1

    %0:sgpr(s32) = COPY $sgpr0
    %1:sgpr(s32) = COPY $sgpr1
    G_SUCC_ARGS %bb.2, %1(s32)
    G_BRCOND %0(s32), %bb.1
    G_BR %bb.2

  bb.1:
    S_ENDPGM 0

  bb.2:
    arguments: %a:sgpr(s32)
    $sgpr0 = COPY %a(s32)
    S_ENDPGM 0
...
