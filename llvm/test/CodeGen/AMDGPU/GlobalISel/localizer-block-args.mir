# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=localizer %s -o - | FileCheck %s

# Localized constants feeding a terminator or a G_SUCC_ARGS must be inserted
# before the block's SUCC_ARGS cluster, which stays contiguous with the
# terminators.
---
name:            localize_into_cluster
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: localize_into_cluster
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s1) = G_CONSTANT i1 true
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[C2:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[C2]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   arguments: %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(s32) = G_ADD %3:_, %3:_
  ; CHECK-NEXT:   [[C3:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[C4:%[0-9]+]]:_(s1) = G_CONSTANT i1 true
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[C3]](s32)
  ; CHECK-NEXT:   G_BRCOND [[C4]](s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $vgpr0 = COPY %3:_(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1

    %0:_(s1) = G_CONSTANT i1 true
    %1:_(s32) = G_CONSTANT i32 0
    %2:_(s32) = G_CONSTANT i32 1
    G_SUCC_ARGS %bb.1, %1(s32)
    G_BR %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    arguments: %3:_(s32)

    %4:_(s32) = G_ADD %3, %3
    G_SUCC_ARGS %bb.1, %2(s32)
    G_BRCOND %0(s1), %bb.1
    G_BR %bb.2

  bb.2:
    $vgpr0 = COPY %3(s32)
    SI_RETURN implicit $vgpr0
...
