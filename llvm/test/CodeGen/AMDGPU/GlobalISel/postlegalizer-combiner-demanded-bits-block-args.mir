# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=amdgpu-postlegalizer-combiner %s -o - | FileCheck %s

# Demanded bits simplification reaching a block argument, which has no defining
# instruction to simplify.
---
name:            single_use
legalized:       true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: single_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %1(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 16
  ; CHECK-NEXT:   [[SHL:%[0-9]+]]:_(s32) = G_SHL %1:_, [[C]](s32)
  ; CHECK-NEXT:   $vgpr0 = COPY [[SHL]](s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0

    %0:_(s32) = COPY $vgpr0
    G_SUCC_ARGS %bb.1, %0(s32)
    G_BR %bb.1

  bb.1:
    arguments: %1:_(s32)

    %2:_(s32) = G_CONSTANT i32 65535
    %3:_(s32) = G_AND %1, %2
    %4:_(s32) = G_CONSTANT i32 16
    %5:_(s32) = G_SHL %3, %4(s32)
    $vgpr0 = COPY %5(s32)
    SI_RETURN implicit $vgpr0
...

---
name:            multi_use
legalized:       true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: multi_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %1(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 255
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:_(s32) = G_AND %1:_, [[C]]
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 24
  ; CHECK-NEXT:   [[SHL:%[0-9]+]]:_(s32) = G_SHL %1:_, [[C1]](s32)
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(s32) = G_ADD [[SHL]], [[AND]]
  ; CHECK-NEXT:   $vgpr0 = COPY [[ADD]](s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0

    %0:_(s32) = COPY $vgpr0
    G_SUCC_ARGS %bb.1, %0(s32)
    G_BR %bb.1

  bb.1:
    arguments: %1:_(s32)

    %2:_(s32) = G_CONSTANT i32 255
    %3:_(s32) = G_AND %1, %2
    %4:_(s32) = G_CONSTANT i32 24
    %5:_(s32) = G_SHL %3, %4(s32)
    %6:_(s32) = G_ADD %5, %3
    $vgpr0 = COPY %6(s32)
    SI_RETURN implicit $vgpr0
...
