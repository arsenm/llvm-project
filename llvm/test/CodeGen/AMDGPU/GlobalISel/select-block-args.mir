# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=instruction-select %s -o - | FileCheck %s

# G_SUCC_ARGS selects to the SUCC_ARGS pseudo. The successor's block-argument
# receiver registers have no defining instruction, so instruction selection must
# constrain them to a register class (as it does for a PHI def).
---
name:            sel_amd
legalized:       true
regBankSelected: true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: sel_amd
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   %y:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, %x, %y
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2, %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr0 = COPY %a:vgpr_32
  ; CHECK-NEXT:   $vgpr1 = COPY %b:vgpr_32
  ; CHECK-NEXT:   S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
  bb.0:
    liveins: $vgpr0, $vgpr1
    successors: %bb.1
    %x:vgpr(s32) = COPY $vgpr0
    %y:vgpr(s32) = COPY $vgpr1
    G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
    G_BR %bb.1
  bb.1:
    arguments: %a:vgpr(s32), %b:vgpr(s32)
    $vgpr0 = COPY %a(s32)
    $vgpr1 = COPY %b(s32)
    S_ENDPGM 0, implicit $vgpr0, implicit $vgpr1
...
---
# A block reached from two predecessors with heterogeneous block arguments of
# different banks (vgpr32 + sgpr64): each predecessor's G_SUCC_ARGS selects to
# SUCC_ARGS and the receiver registers are constrained to a register class
# matching each forwarded value's bank.
name:            sel_amd_hetero
legalized:       true
regBankSelected: true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: sel_amd_hetero
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0, $sgpr1, $sgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %v:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   %s:sreg_64 = COPY $sgpr0_sgpr1
  ; CHECK-NEXT:   %cond:sreg_32 = COPY $sgpr2
  ; CHECK-NEXT:   $scc = COPY %cond
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %v1:vgpr_32 = V_MOV_B32_e32 3, implicit $exec
  ; CHECK-NEXT:   %s1:sreg_64 = S_MOV_B64 9
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, %v1, %s1
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, %v, %s
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   arguments: %5, %6
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr0 = COPY %av:vgpr_32
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $vgpr0, $sgpr0, $sgpr1, $sgpr2
    successors: %bb.1, %bb.2

    %v:vgpr(s32) = COPY $vgpr0
    %s:sgpr(s64) = COPY $sgpr0_sgpr1
    %cond:sgpr(s32) = COPY $sgpr2
    G_BRCOND %cond(s32), %bb.2
    G_BR %bb.1

  bb.1:
    successors: %bb.3

    %v1:vgpr(s32) = G_CONSTANT i32 3
    %s1:sgpr(s64) = G_CONSTANT i64 9
    G_SUCC_ARGS %bb.3, %v1(s32), %s1(s64)
    G_BR %bb.3

  bb.2:
    successors: %bb.3

    G_SUCC_ARGS %bb.3, %v(s32), %s(s64)
    G_BR %bb.3

  bb.3:
    arguments: %av:vgpr(s32), %as:sgpr(s64)

    $vgpr0 = COPY %av(s32)
    S_ENDPGM 0
...
---
# A vcc(s1) block argument used as the source of G_AMDGPU_BALLOT. selectBallot
# checks isLaneMaskFromSameBlock on the source; a block-argument source has no
# defining instruction, so that check must not dereference a null def.
name:            ballot_block_arg
legalized:       true
regBankSelected: true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: ballot_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   %c:sreg_32 = S_MOV_B32 0
  ; CHECK-NEXT:   %m:sreg_64_xexec = V_CMP_NE_U32_e64 %x, %c, implicit $exec
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, %m
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %b:sreg_64 = S_AND_B64 %a:sreg_64_xexec, $exec, implicit-def dead $scc
  ; CHECK-NEXT:   $sgpr0_sgpr1 = COPY %b
  ; CHECK-NEXT:   S_ENDPGM 0, implicit $sgpr0_sgpr1
  bb.0:
    liveins: $vgpr0
    successors: %bb.1

    %x:vgpr(s32) = COPY $vgpr0
    %c:sgpr(s32) = G_CONSTANT i32 0
    %m:vcc(s1) = G_ICMP intpred(ne), %x(s32), %c
    G_SUCC_ARGS %bb.1, %m(s1)
    G_BR %bb.1

  bb.1:
    arguments: %a:vcc(s1)

    %b:sgpr(s64) = G_INTRINSIC_CONVERGENT intrinsic(@llvm.amdgcn.ballot), %a(s1)
    $sgpr0_sgpr1 = COPY %b(s64)
    S_ENDPGM 0, implicit $sgpr0_sgpr1
...
