; RUN: llc -mtriple=amdgpu11.00 -O3 -global-isel < %s | FileCheck %s
; RUN: llc -mtriple=amdgpu11.00 -O3 -global-isel -gisel-use-block-args < %s | FileCheck %s

; A uniform loop-carried pointer is an SGPR block argument reached through a
; copy, and must still select the saddr form that the PHI path uses.

define amdgpu_kernel void @scratch_saddr(i32 %n) {
; CHECK-LABEL: scratch_saddr:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_b32 s0, s[4:5], 0x24
; CHECK-NEXT:    s_mov_b32 s1, 0
; CHECK-NEXT:    s_mov_b32 s2, 0
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1)
; CHECK-NEXT:    v_mov_b32_e32 v0, s2
; CHECK-NEXT:    s_add_i32 s2, s2, 1
; CHECK-NEXT:    scratch_store_b32 off, v0, s1 dlc
; CHECK-NEXT:    s_waitcnt_vscnt null, 0x0
; CHECK-NEXT:    s_add_u32 s1, s1, 4
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    s_cmp_lt_i32 s2, s0
; CHECK-NEXT:    s_cbranch_scc1 .LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %exit
; CHECK-NEXT:    s_endpgm
entry:
  %a = alloca [64 x i32], align 4, addrspace(5)
  br label %loop
loop:
  %p = phi ptr addrspace(5) [ %a, %entry ], [ %p.next, %loop ]
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  store volatile i32 %i, ptr addrspace(5) %p
  %p.next = getelementptr i32, ptr addrspace(5) %p, i32 1
  %i.next = add i32 %i, 1
  %c = icmp slt i32 %i.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}
