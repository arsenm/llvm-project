# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=reg-bank-select %s -o - | FileCheck %s

# RegBankSelect assigns register banks to block-argument receiver registers, even
# though they have no defining instruction. Because the def-driven walk never
# visits them, their bank is seeded from the values their predecessors forward.
# A block argument whose only use is copy-like (e.g. a copy to a physical
# register) has nothing to repair its bank from, so this seeding is required for
# it to end up banked.
--- |
  define void @copy_only_use(i32 %x) {
    br label %next
  next:
    ret void
  }
...
---
name:            copy_only_use
legalized:       true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: copy_only_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %1(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr0 = COPY %1:vgpr(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0

    %0:_(s32) = COPY $vgpr0
    G_SUCC_ARGS %bb.1, %0(s32)
    G_BR %bb.1

  bb.1:
    arguments: %1:_(s32)

    $vgpr0 = COPY %1(s32)
    SI_RETURN implicit $vgpr0
...
