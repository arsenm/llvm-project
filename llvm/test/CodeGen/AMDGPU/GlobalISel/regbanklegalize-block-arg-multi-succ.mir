# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx900 -run-pass=amdgpu-reg-bank-legalize -verify-machineinstrs %s -o - | FileCheck %s

# A block forwards the same SGPR value to two successors whose block-argument
# receivers are VGPR, so the SuccArgs applier inserts a reconcile copy for each
# forwarder. The copies must be placed before the SUCC_ARGS cluster, not between
# the two forwarders, to keep the cluster free of interleaved non-terminators.
---
name:            multi_succ_reconcile
legalized:       true
regBankSelected:  true
tracksRegLiveness: true
usesBlockArgs:   true
registers:
  - { id: 0, class: vgpr }
  - { id: 1, class: sgpr }
  - { id: 2, class: vcc }
  - { id: 3, class: vgpr }
  - { id: 4, class: vgpr }
body:             |
  ; CHECK-LABEL: name: multi_succ_reconcile
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr(s32) = COPY $sgpr0
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:vcc(s1) = G_ICMP intpred(eq), [[COPY]](s32), [[COPY]]
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr(s32) = COPY [[COPY1]](s32)
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:vgpr(s32) = COPY [[COPY1]](s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY2]](s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.2, [[COPY3]](s32)
  ; CHECK-NEXT:   G_BRCOND [[ICMP]](s1), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_ENDPGM 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %4(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    liveins: $vgpr0, $sgpr0
    successors: %bb.1, %bb.2

    %0:vgpr(s32) = COPY $vgpr0
    %1:sgpr(s32) = COPY $sgpr0
    %2:vcc(s1) = G_ICMP intpred(eq), %0, %0
    G_SUCC_ARGS %bb.1, %1(s32)
    G_SUCC_ARGS %bb.2, %1(s32)
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2

  bb.1:
    arguments: %3(s32)
    S_ENDPGM 0

  bb.2:
    arguments: %4(s32)
    S_ENDPGM 0
...
