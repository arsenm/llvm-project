; The artifact combiner looks for the unmerge defining a block argument.
define amdgpu_kernel void @unmerge_block_arg(i1 %c) {
; CHECK-LABEL: unmerge_block_arg:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_b32 s1, s[4:5], 0x24
; CHECK-NEXT:    s_mov_b32 s0, 0
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    s_xor_b32 s1, s1, 1
; CHECK-NEXT:    s_delay_alu instid0(SALU_CYCLE_1) | instskip(NEXT) | instid1(SALU_CYCLE_1)
; CHECK-NEXT:    s_and_b32 s1, s1, 1
; CHECK-NEXT:    s_cmp_lg_u32 s1, 0
; CHECK-NEXT:    s_cbranch_scc0 .LBB1_2
; CHECK-NEXT:  .LBB1_1: ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    s_mov_b32 s2, 0
; CHECK-NEXT:    s_cmp_lg_u32 s1, 0
; CHECK-NEXT:    s_cbranch_scc1 .LBB1_1
; CHECK-NEXT:  .LBB1_2: ; %if
