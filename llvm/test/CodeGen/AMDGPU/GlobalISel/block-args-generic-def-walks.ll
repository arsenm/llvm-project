; CHECK-NEXT:    s_mov_b32 s2, 1.0
; CHECK-NEXT:    s_cmp_lg_u32 s1, 0
; CHECK-NEXT:    s_cbranch_scc1 .LBB1_1
; CHECK-NEXT:    s_branch .LBB1_2
; CHECK-NEXT:  .LBB1_4: ; %DummyReturnBlock
; CHECK-NEXT:    s_endpgm
entry:
  br label %loop

loop:
  %vec = phi <4 x float> [ zeroinitializer, %entry ], [ %vec.next, %latch ]
  br i1 %c, label %if, label %latch

if:
  %ins = insertelement <4 x float> %vec, float 0.0, i64 0
  br label %latch

latch:
  %vec.if = phi <4 x float> [ %ins, %if ], [ %vec, %loop ]
  %elt = phi float [ 1.0, %if ], [ 0.0, %loop ]
  %ins0 = insertelement <4 x float> %vec.if, float %elt, i64 0
  %vec.next = insertelement <4 x float> %ins0, float 0.0, i64 1
  br label %loop
}
