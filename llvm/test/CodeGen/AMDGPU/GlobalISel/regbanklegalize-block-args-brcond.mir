# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=amdgpu-reg-bank-legalize -verify-machineinstrs %s -o - | FileCheck %s

# RegBankLegalize widens a G_BRCOND's i1 condition with an anyext + AND-with-1
# boolean cleanup. Those are not terminators, so when the block has a SUCC_ARGS
# cluster they must be emitted before it, not at the branch (which sits after
# the cluster).
---
name:            rbl_brcond
legalized:       true
tracksRegLiveness: true
usesBlockArgs:   true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: rbl_brcond
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sgpr(s32) = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr(s32) = COPY $sgpr1
  ; CHECK-NEXT:   [[C:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:sgpr(i32) = G_ICMP intpred(eq), [[COPY]](s32), [[C]]
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:sgpr(i32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:sgpr(i32) = G_AND [[ICMP]], [[C1]]
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.2, [[COPY1]](s32)
  ; CHECK-NEXT:   G_BRCOND [[AND]](i32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   S_ENDPGM 0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %4(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $sgpr0 = COPY %a:sgpr(s32)
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr0, $sgpr1

    %0:sgpr(s32) = COPY $sgpr0
    %1:sgpr(s32) = COPY $sgpr1
    %2:sgpr(s32) = G_CONSTANT i32 0
    %3:sgpr(s1) = G_ICMP intpred(eq), %0(s32), %2
    G_SUCC_ARGS %bb.2, %1(s32)
    G_BRCOND %3(s1), %bb.1
    G_BR %bb.2

  bb.1:
    S_ENDPGM 0

  bb.2:
    arguments: %a:sgpr(s32)

    $sgpr0 = COPY %a(s32)
    S_ENDPGM 0
...
