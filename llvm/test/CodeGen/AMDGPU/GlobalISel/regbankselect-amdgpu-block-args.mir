# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00-amd-amdhsa -run-pass=amdgpu-reg-bank-select -verify-machineinstrs %s -o - | FileCheck %s

# AMDGPURegBankSelect assigns register banks to block-argument receiver
# registers, even though they have no defining instruction. The def/use walk
# never assigns them a bank, so they are seeded up front from the uniformity
# analysis. A block argument whose only use is copy-like (a copy to a physical
# register) has nothing to constrain its bank from, so this seeding is required.
--- |
  define void @copy_only_use() { ret void }
  define void @hetero() { ret void }
  define void @lane_mask_arg() { ret void }
...
---
name:            copy_only_use
tracksRegLiveness: true
usesBlockArgs:   true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: copy_only_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr(s32) = COPY $vgpr0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %1(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr0 = COPY %1:vgpr(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0

    %0:_(s32) = COPY $vgpr0
    G_SUCC_ARGS %bb.1, %0(s32)
    G_BR %bb.1

  bb.1:
    arguments: %1:_(s32)

    $vgpr0 = COPY %1(s32)
    SI_RETURN implicit $vgpr0
...
---
# Heterogeneous block arguments are each seeded with the bank the uniformity
# analysis picks for the forwarded value: the value coming from a VGPR is
# divergent (vgpr), the one from an SGPR is uniform (sgpr).
name:            hetero
legalized:       true
tracksRegLiveness: true
usesBlockArgs:   true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: hetero
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %v:vgpr(s32) = COPY $vgpr0
  ; CHECK-NEXT:   %s:sgpr(s32) = COPY $sgpr0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %v(s32), %s(s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2(s32), %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr0 = COPY %av:vgpr(s32)
  ; CHECK-NEXT:   $sgpr0 = COPY %as:sgpr(s32)
  ; CHECK-NEXT:   S_ENDPGM 0, implicit $vgpr0, implicit $sgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $sgpr0

    %v:_(s32) = COPY $vgpr0
    %s:_(s32) = COPY $sgpr0
    G_SUCC_ARGS %bb.1, %v(s32), %s(s32)
    G_BR %bb.1

  bb.1:
    arguments: %av:_(s32), %as:_(s32)

    $vgpr0 = COPY %av(s32)
    $sgpr0 = COPY %as(s32)
    S_ENDPGM 0, implicit $vgpr0, implicit $sgpr0
...
---
# A block argument used as a lane mask by a pre-inst-selected instruction (here
# SI_IF) has a register class (sreg_64_xexec) but no defining instruction. The
# use-operand walk must not dereference its (null) defining instruction while
# deciding whether the def is a pre-inst-selected opcode.
name:            lane_mask_arg
tracksRegLiveness: true
usesBlockArgs:   true
machineFunctionInfo:
  isEntryFunction: true
body:             |
  ; CHECK-LABEL: name: lane_mask_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr0_sgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_64_xexec(s1) = COPY $sgpr0_sgpr1
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY]](s1)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   arguments: %1(s1)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:sgpr(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sgpr(s1) = COPY %1:sreg_64_xexec(s1)
  ; CHECK-NEXT:   [[SELECT:%[0-9]+]]:sgpr(s32) = G_SELECT [[COPY1]](s1), [[C]], [[C1]]
  ; CHECK-NEXT:   [[SI_IF:%[0-9]+]]:sreg_64_xexec = SI_IF %1:sreg_64_xexec(s1), %bb.3, implicit-def $exec, implicit-def $scc, implicit $exec
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   SI_END_CF [[SI_IF]], implicit-def $exec, implicit-def $scc, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0, implicit [[SELECT]](s32)
  bb.0:
    successors: %bb.1
    liveins: $sgpr0_sgpr1

    %0:sreg_64_xexec(s1) = COPY $sgpr0_sgpr1
    G_SUCC_ARGS %bb.1, %0(s1)
    G_BR %bb.1

  bb.1:
    successors: %bb.2, %bb.3
    arguments: %1:sreg_64_xexec(s1)

    ; A pre-inst-selected use (G_SELECT) of the lane-mask block argument, whose
    ; register class came from pre-inst-selection; the use walk must not
    ; dereference its null defining instruction.
    %3:_(s32) = G_CONSTANT i32 0
    %4:_(s32) = G_CONSTANT i32 1
    %5:_(s32) = G_SELECT %1(s1), %3, %4
    %2:sreg_64_xexec = SI_IF %1(s1), %bb.3, implicit-def $exec, implicit-def $scc, implicit $exec
    G_BR %bb.2

  bb.2:
    successors: %bb.3

    G_BR %bb.3

  bb.3:
    SI_END_CF %2, implicit-def $exec, implicit-def $scc, implicit $exec
    S_ENDPGM 0, implicit %5(s32)
...
