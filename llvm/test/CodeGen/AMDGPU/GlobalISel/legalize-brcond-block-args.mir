  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(s64) = COPY $sgpr0_sgpr1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64_xexec(s64) = COPY [[COPY1]](s64)
