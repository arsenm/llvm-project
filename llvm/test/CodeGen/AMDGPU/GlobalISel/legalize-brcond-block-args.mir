# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -O0 -run-pass=legalizer %s -o - | FileCheck %s

# The condition copies for SI_IF, SI_ELSE and SI_LOOP must be placed before the
# SUCC_ARGS cluster.

---
name: brcond_si_if_succ_args
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: brcond_si_if_succ_args
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(s32) = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(s32) = COPY $vgpr1
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:_(s1) = G_ICMP intpred(ne), [[COPY]](s32), [[COPY1]]
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64_xexec(s1) = COPY [[ICMP]](s1)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.2, [[COPY]](s32)
  ; CHECK-NEXT:   [[SI_IF:%[0-9]+]]:sreg_64_xexec(s64) = SI_IF [[COPY2]](s1), %bb.2, implicit-def $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.2, [[COPY1]](s32)
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %5(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.end.cf), [[SI_IF]](s64)
  ; CHECK-NEXT:   $vgpr0 = COPY %5:_(s32)
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s1) = G_ICMP intpred(ne), %0, %1
    %3:_(s1), %4:_(s64) = G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.if), %2
    G_SUCC_ARGS %bb.2, %0
    G_BRCOND %3, %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.2
    G_SUCC_ARGS %bb.2, %1
    G_BR %bb.2

  bb.2:
    arguments: %5:_(s32)
    G_INTRINSIC_W_SIDE_EFFECTS intrinsic(@llvm.amdgcn.end.cf), %4
    $vgpr0 = COPY %5
    SI_RETURN implicit $vgpr0
...

