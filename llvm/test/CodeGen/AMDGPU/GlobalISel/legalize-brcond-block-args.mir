  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   arguments: %2(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:sreg_64_xexec(s64) = COPY [[COPY1]](s64)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %2:_(s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.2, %2:_(s32)
  ; CHECK-NEXT:   SI_LOOP [[COPY2]](s64), %bb.1, implicit-def $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   G_BR %bb.2
