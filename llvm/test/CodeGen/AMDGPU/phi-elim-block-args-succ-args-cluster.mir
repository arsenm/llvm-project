# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgcn-- -run-pass=phi-node-elimination -verify-machineinstrs -o - %s | FileCheck %s

# A self-loop block forwards its arguments to two successors. Lowering the
# self-edge, SIInstrInfo::createPHIDestinationCopy must not place a destination
# copy before a SUCC_ARGS: doing so would split the SUCC_ARGS %bb.2 forwarder
# from the terminators, so the later lookup for %bb.2's forwarder would fail.

---
name:            self_loop_two_succ_args
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: self_loop_two_succ_args
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $vgpr1, $vgpr2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr2
  ; CHECK-NEXT:   [[S_MOV_B64_:%[0-9]+]]:sreg_64 = S_MOV_B64 0
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:sreg_64 = COPY [[S_MOV_B64_]]
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY]]
  ; CHECK-NEXT:   [[COPY5:%[0-9]+]]:vgpr_32 = COPY [[COPY1]]
  ; CHECK-NEXT:   [[COPY6:%[0-9]+]]:vgpr_32 = COPY [[COPY2]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x04000000), %bb.1(0x7c000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY7:%[0-9]+]]:vgpr_32 = COPY [[COPY4]]
  ; CHECK-NEXT:   [[COPY8:%[0-9]+]]:vgpr_32 = COPY [[COPY5]]
  ; CHECK-NEXT:   [[COPY9:%[0-9]+]]:vgpr_32 = COPY [[COPY6]]
  ; CHECK-NEXT:   [[V_ADD_CO_U32_e64_:%[0-9]+]]:vgpr_32, dead [[V_ADD_CO_U32_e64_1:%[0-9]+]]:sreg_64 = V_ADD_CO_U32_e64 -1, [[COPY9]], 0, implicit $exec
  ; CHECK-NEXT:   [[V_CMP_EQ_U32_e64_:%[0-9]+]]:sreg_64 = V_CMP_EQ_U32_e64 0, [[V_ADD_CO_U32_e64_]], implicit $exec
  ; CHECK-NEXT:   [[COPY10:%[0-9]+]]:sreg_64 = COPY [[COPY3]]
  ; CHECK-NEXT:   [[SI_IF_BREAK:%[0-9]+]]:sreg_64 = SI_IF_BREAK killed [[V_CMP_EQ_U32_e64_]], [[COPY10]], implicit-def dead $scc
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:sreg_64 = COPY [[SI_IF_BREAK]]
  ; CHECK-NEXT:   [[COPY4:%[0-9]+]]:vgpr_32 = COPY [[COPY8]]
  ; CHECK-NEXT:   [[COPY5:%[0-9]+]]:vgpr_32 = COPY [[COPY7]]
  ; CHECK-NEXT:   [[COPY6:%[0-9]+]]:vgpr_32 = COPY [[V_ADD_CO_U32_e64_]]
  ; CHECK-NEXT:   [[COPY11:%[0-9]+]]:vgpr_32 = COPY [[COPY7]]
  ; CHECK-NEXT:   [[COPY12:%[0-9]+]]:sreg_64 = COPY [[SI_IF_BREAK]]
  ; CHECK-NEXT:   SI_LOOP killed [[SI_IF_BREAK]], %bb.1, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   [[COPY13:%[0-9]+]]:sreg_64 = COPY [[COPY12]]
  ; CHECK-NEXT:   SI_END_CF [[COPY13]], implicit-def dead $exec, implicit-def dead $scc, implicit $exec
  ; CHECK-NEXT:   [[COPY14:%[0-9]+]]:vgpr_32 = COPY [[COPY11]]
  ; CHECK-NEXT:   $vgpr0 = COPY [[COPY14]]
  ; CHECK-NEXT:   SI_RETURN implicit killed $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $vgpr0, $vgpr1, $vgpr2

    %16:vgpr_32 = COPY $vgpr0
    %17:vgpr_32 = COPY $vgpr1
    %18:vgpr_32 = COPY $vgpr2
    %21:sreg_64 = S_MOV_B64 0
    SUCC_ARGS %bb.1, killed %21, killed %16, killed %17, killed %18

  bb.1:
    successors: %bb.2(0x04000000), %bb.1(0x7c000000)
    arguments: %0:sreg_64, %1:vgpr_32, %2:vgpr_32, %3:vgpr_32

    %4:vgpr_32, dead %23:sreg_64 = V_ADD_CO_U32_e64 -1, %3, 0, implicit $exec
    %25:sreg_64 = V_CMP_EQ_U32_e64 0, %4, implicit $exec
    %5:sreg_64 = SI_IF_BREAK killed %25, %0, implicit-def dead $scc
    SUCC_ARGS %bb.2, %1, %5
    SUCC_ARGS %bb.1, %5, %2, %1, killed %4
    SI_LOOP killed %5, %bb.1, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.2

  bb.2:
    arguments: %6:vgpr_32, %7:sreg_64

    SI_END_CF %7, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    $vgpr0 = COPY %6
    SI_RETURN implicit killed $vgpr0
...
