# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -sdag-use-block-args -run-pass=si-fix-sgpr-copies -o - %s | FileCheck %s

# A divergent VGPR value is forwarded to an SGPR block argument, whose scalar
# ALU user is moved to VALU, whose VGPR result is itself forwarded to a
# downstream SGPR block argument. Reconciling each argument to the VGPR class
# must interleave with moving the intervening SALU use, so divergence
# propagates through the whole forwarding chain rather than stopping at the
# first argument.

---
name: transitive_chain
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: transitive_chain
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:vgpr_32 = IMPLICIT_DEF
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[DEF]]
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   arguments: %1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 1
  ; CHECK-NEXT:   [[V_ADD_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e64 %1:vgpr_32, [[S_MOV_B32_]], 0, implicit $exec
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[V_ADD_U32_e64_]]
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   arguments: %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, %4:vgpr_32
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   arguments: %5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_MOV_B32_e32_:%[0-9]+]]:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
  ; CHECK-NEXT:   [[V_ADD_U32_e64_1:%[0-9]+]]:vgpr_32 = V_ADD_U32_e64 %5:vgpr_32, [[V_MOV_B32_e32_]], 0, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0, implicit [[V_ADD_U32_e64_1]]
  bb.0:
    successors: %bb.1
    %0:vgpr_32 = IMPLICIT_DEF
    SUCC_ARGS %bb.1, %0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    arguments: %1:sreg_32
    %2:sreg_32 = S_MOV_B32 1
    %3:sreg_32 = S_ADD_I32 %1, %2, implicit-def dead $scc
    SUCC_ARGS %bb.2, %3
    S_BRANCH %bb.2

  bb.2:
    successors: %bb.3
    arguments: %4:sreg_32
    SUCC_ARGS %bb.3, %4
    S_BRANCH %bb.3

  bb.3:
    arguments: %5:sreg_32
    %6:vgpr_32 = V_MOV_B32_e32 0, implicit $exec
    %7:vgpr_32 = V_ADD_U32_e64 %5, %6, 0, implicit $exec
    S_ENDPGM 0, implicit %7
...
