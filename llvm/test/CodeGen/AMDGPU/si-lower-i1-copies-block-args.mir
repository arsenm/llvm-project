# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=si-i1-copies -o - %s | FileCheck %s

# An i1 block argument fed an undef value through one predecessor's SUCC_ARGS.
# The undef operand has no defining instruction, so lookup of its def must
# tolerate a null result and skip the edge rather than dereferencing it.
---
name: undef_i1_succ_arg
tracksRegLiveness: true
noPhis: false
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: undef_i1_succ_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $vgpr0, $sgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:sreg_64 = IMPLICIT_DEF
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, undef [[DEF]]
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_CMP_LT_U32_e64_:%[0-9]+]]:sreg_64 = V_CMP_LT_U32_e64 [[COPY]], 8, implicit $exec
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[V_CMP_LT_U32_e64_]]
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:sreg_64 = PHI [[DEF]], %bb.0, [[V_CMP_LT_U32_e64_]], %bb.1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_64_xexec = COPY %4:sreg_64
  ; CHECK-NEXT:   [[V_CNDMASK_B32_e64_:%[0-9]+]]:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 1, [[COPY1]], implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $sgpr0

    %0:vgpr_32 = COPY $vgpr0
    S_CMP_LG_U32 $sgpr0, 0, implicit-def $scc
    SUCC_ARGS %bb.2, undef %3:vreg_1
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    %1:sreg_64 = V_CMP_LT_U32_e64 %0, 8, implicit $exec
    %2:vreg_1 = COPY %1
    SUCC_ARGS %bb.2, %2
    S_BRANCH %bb.2

  bb.2:
    arguments: %4:vreg_1
    %5:sreg_64_xexec = COPY %4
    %6:vgpr_32 = V_CNDMASK_B32_e64 0, 0, 0, 1, %5, implicit $exec
    S_ENDPGM 0
...
