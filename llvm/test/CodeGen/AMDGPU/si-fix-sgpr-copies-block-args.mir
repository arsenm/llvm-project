# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu9.00 -run-pass=si-fix-sgpr-copies -o - %s | FileCheck %s

# A block argument fed by a divergent (VGPR) value through one predecessor's
# SUCC_ARGS must be moved to a VGPR class, just as a PHI with a VGPR operand is.
# Otherwise PHI elimination lowers the edge to an illegal VGPR-to-SGPR copy.

---
name: block_arg_mixed_bank
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: block_arg_mixed_bank
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0, $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   S_CMP_LG_U32 [[COPY]], 0, implicit-def $scc
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[COPY]]
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_ADD_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e64 [[COPY1]], [[COPY1]], 0, implicit $exec
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[V_ADD_U32_e64_]]
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr0 = COPY %3:vgpr_32
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr0, $vgpr0

    %0:sreg_32 = COPY $sgpr0
    %1:vgpr_32 = COPY $vgpr0
    S_CMP_LG_U32 %0, 0, implicit-def $scc
    SUCC_ARGS %bb.2, %0
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    %3:vgpr_32 = V_ADD_U32_e64 %1, %1, 0, implicit $exec
    SUCC_ARGS %bb.2, %3
    S_BRANCH %bb.2

  bb.2:
    arguments: %2:sreg_32
    $vgpr0 = COPY %2
    SI_RETURN implicit $vgpr0
...

# A loop-header block argument that is uniform on entry but receives a
# divergent (VGPR) value on the backedge's SUCC_ARGS must be moved to VGPR,
# just as a loop-carried PHI with a VGPR operand is.
---
name: block_arg_loop_backedge
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: block_arg_loop_backedge
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $sgpr0, $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY]]
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   arguments: %2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[V_ADD_U32_e64_:%[0-9]+]]:vgpr_32 = V_ADD_U32_e64 [[COPY1]], %2:vgpr_32, 0, implicit $exec
  ; CHECK-NEXT:   S_CMP_LG_U32 [[COPY]], 0, implicit-def $scc
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[V_ADD_U32_e64_]]
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   $vgpr0 = COPY %2:vgpr_32
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0
  bb.0:
    successors: %bb.1
    liveins: $sgpr0, $vgpr0

    %0:sreg_32 = COPY $sgpr0
    %1:vgpr_32 = COPY $vgpr0
    SUCC_ARGS %bb.1, %0
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    arguments: %2:sreg_32

    %3:vgpr_32 = V_ADD_U32_e64 %1, %2, 0, implicit $exec
    S_CMP_LG_U32 %0, 0, implicit-def $scc
    SUCC_ARGS %bb.1, %3
    S_CBRANCH_SCC1 %bb.1, implicit $scc
    S_BRANCH %bb.2

  bb.2:
    $vgpr0 = COPY %2
    SI_RETURN implicit $vgpr0
...

# Each SUCC_ARGS operand position is scored independently. The first block
# argument is uniform through both predecessors and stays SGPR, while the
# second receives a divergent (VGPR) value from one predecessor and is moved
# to VGPR.
---
name: block_arg_multi_mixed_positions
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: block_arg_multi_mixed_positions
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $sgpr0, $sgpr1, $vgpr0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:sreg_32 = COPY $sgpr0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:sreg_32 = COPY $sgpr1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:vgpr_32 = COPY $vgpr0
  ; CHECK-NEXT:   S_CMP_LG_U32 [[COPY]], 0, implicit-def $scc
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[COPY]], [[COPY2]]
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT:   S_BRANCH %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[S_MOV_B32_:%[0-9]+]]:sreg_32 = S_MOV_B32 7
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[S_MOV_B32_]], [[COPY1]]
  ; CHECK-NEXT:   S_BRANCH %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %4, %5
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr0 = COPY %4:sreg_32
  ; CHECK-NEXT:   $vgpr1 = COPY %5:vgpr_32
  ; CHECK-NEXT:   SI_RETURN implicit $vgpr0, implicit $vgpr1
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sgpr0, $sgpr1, $vgpr0

    %0:sreg_32 = COPY $sgpr0
    %1:sreg_32 = COPY $sgpr1
    %2:vgpr_32 = COPY $vgpr0
    S_CMP_LG_U32 %0, 0, implicit-def $scc
    SUCC_ARGS %bb.2, %0, %2
    S_CBRANCH_SCC1 %bb.2, implicit $scc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    %6:sreg_32 = S_MOV_B32 7
    SUCC_ARGS %bb.2, %6, %1
    S_BRANCH %bb.2

  bb.2:
    arguments: %3:sreg_32, %4:sreg_32
    $vgpr0 = COPY %3
    $vgpr1 = COPY %4
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...
