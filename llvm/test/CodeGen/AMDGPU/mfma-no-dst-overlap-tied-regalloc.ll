; RUN: llc -mtriple=amdgpu9.50-amd-amdhsa -O3 < %s | FileCheck %s

; A chain of two large (512-bit accumulator) MFMAs under a tight occupancy
; budget (amdgpu-waves-per-eu=8 -> 32 VGPRs). The accumulator carries an
; EARLY_CLOBBER_ALIASES constraint, so the allocator may keep vdst and src2
; on the same 16-VGPR tuple (equal), which fits the budget. Previously the tied
; form was unconditionally converted to an early-clobber (disjoint) form pre-RA,
; forcing two disjoint 16-VGPR accumulators and failing register allocation with
; "ran out of registers".

define amdgpu_kernel void @mfma_chain_tied_accumulator_fits_budget() #0 {
; CHECK-LABEL: mfma_chain_tied_accumulator_fits_budget:
; CHECK:       v_mfma_f32_32x32x16_bf16 [[ACC:v\[[0-9]+:[0-9]+\]]], v[{{[0-9:]+}}], v[{{[0-9:]+}}], 0
; CHECK:       v_mfma_f32_32x32x16_bf16 [[ACC]], v[{{[0-9:]+}}], v[{{[0-9:]+}}], [[ACC]]
bb:
  %i = tail call <16 x float> @llvm.amdgcn.mfma.f32.32x32x16.bf16(<8 x bfloat> zeroinitializer, <8 x bfloat> zeroinitializer, <16 x float> zeroinitializer, i32 0, i32 0, i32 0)
  %i1 = tail call <16 x float> @llvm.amdgcn.mfma.f32.32x32x16.bf16(<8 x bfloat> zeroinitializer, <8 x bfloat> zeroinitializer, <16 x float> %i, i32 0, i32 0, i32 0)
  %i2 = tail call <16 x float> @llvm.amdgcn.mfma.f32.32x32x16.bf16(<8 x bfloat> zeroinitializer, <8 x bfloat> zeroinitializer, <16 x float> zeroinitializer, i32 0, i32 0, i32 0)
  %i3 = shufflevector <16 x float> %i2, <16 x float> zeroinitializer, <2 x i32> <i32 2, i32 3>
  %i4 = fptrunc <2 x float> %i3 to <2 x bfloat>
  %i5 = shufflevector <16 x float> %i1, <16 x float> zeroinitializer, <2 x i32> <i32 10, i32 11>
  %i6 = fptrunc <2 x float> %i5 to <2 x bfloat>
  %i7 = shufflevector <2 x bfloat> %i6, <2 x bfloat> zeroinitializer, <8 x i32> <i32 0, i32 1, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison>
  %i8 = shufflevector <8 x bfloat> zeroinitializer, <8 x bfloat> %i7, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 8, i32 9>
  %i9 = bitcast <8 x bfloat> %i8 to <4 x i32>
  tail call void @llvm.amdgcn.raw.ptr.buffer.store.v4i32(<4 x i32> %i9, ptr addrspace(8) null, i32 0, i32 0, i32 0)
  %i10 = bitcast <2 x bfloat> %i4 to i32
  %i11 = tail call { i32, i32 } @llvm.amdgcn.permlane32.swap(i32 %i10, i32 0, i1 false, i1 false)
  %i12 = extractvalue { i32, i32 } %i11, 1
  %i13 = bitcast i32 %i12 to <2 x bfloat>
  %i14 = shufflevector <2 x bfloat> %i13, <2 x bfloat> zeroinitializer, <8 x i32> <i32 0, i32 1, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison, i32 poison>
  %i15 = shufflevector <8 x bfloat> zeroinitializer, <8 x bfloat> %i14, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 8, i32 9>
  %i16 = bitcast <8 x bfloat> %i15 to <4 x i32>
  tail call void @llvm.amdgcn.raw.ptr.buffer.store.v4i32(<4 x i32> %i16, ptr addrspace(8) null, i32 0, i32 0, i32 0)
  ret void
}

declare <16 x float> @llvm.amdgcn.mfma.f32.32x32x16.bf16(<8 x bfloat>, <8 x bfloat>, <16 x float>, i32 immarg, i32 immarg, i32 immarg) #1
declare { i32, i32 } @llvm.amdgcn.permlane32.swap(i32, i32, i1 immarg, i1 immarg) #2
declare void @llvm.amdgcn.raw.ptr.buffer.store.v4i32(<4 x i32>, ptr addrspace(8) writeonly captures(none), i32, i32, i32 immarg) #3

attributes #0 = { "amdgpu-waves-per-eu"="8,8" }
attributes #1 = { convergent nocallback nocreateundeforpoison nofree nosync nounwind willreturn memory(none) }
attributes #2 = { convergent nocallback nofree nounwind willreturn memory(none) }
attributes #3 = { nocallback nofree nosync nounwind willreturn memory(argmem: write) }
