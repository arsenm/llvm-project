; CHECK-NEXT:    s_addc_u32 flat_scratch_hi, s13, 0
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    global_load_dword v0, v1, s[0:1] glc
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:    v_mov_b32_e32 v3, s3
; CHECK-NEXT:    v_add_u32_e32 v2, 0xffffff00, v0
; CHECK-NEXT:    v_lshlrev_b64 v[0:1], 2, v[0:1]
; CHECK-NEXT:    v_add_co_u32_e32 v0, vcc, s2, v0
; CHECK-NEXT:    v_addc_co_u32_e32 v1, vcc, v3, v1, vcc
; CHECK-NEXT:  .LBB2_1: ; %bb3
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    flat_load_dword v3, v[0:1] glc
; CHECK-NEXT:    s_waitcnt vmcnt(0)
; CHECK-NEXT:    v_add_co_u32_e32 v2, vcc, 1, v2
; CHECK-NEXT:    v_add_co_u32_e64 v0, s[0:1], 4, v0
; CHECK-NEXT:    v_addc_co_u32_e64 v1, s[0:1], 0, v1, s[0:1]
; CHECK-NEXT:    s_and_b64 vcc, exec, vcc
; CHECK-NEXT:    s_cbranch_vccz .LBB2_1
; CHECK-NEXT:  ; %bb.2: ; %bb2
; CHECK-NEXT:    s_endpgm
bb:
  %i2 = load volatile i32, ptr addrspace(1) %arg1, align 4
  br label %bb3

bb2:
