; A divergent loop-carried vector value becomes a block argument fed a VGPR
; value on the back-edge. SIFixSGPRCopies must move the argument to the VGPR
; class so PHI elimination lowers the edge with a legal copy rather than an
; illegal VGPR-to-SGPR copy.
define amdgpu_kernel void @move_divergent_block_arg_to_vgpr(ptr addrspace(3) %ptr, i1 %cond) {
; CHECK-LABEL: move_divergent_block_arg_to_vgpr:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_dword s0, s[8:9], 0x4
; CHECK-NEXT:    ; implicit-def: $vgpr0
; CHECK-NEXT:    ; implicit-def: $vgpr4
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    s_bitcmp1_b32 s0, 0
; CHECK-NEXT:    s_cselect_b64 s[0:1], -1, 0
; CHECK-NEXT:    s_xor_b64 s[0:1], s[0:1], -1
; CHECK-NEXT:  .LBB0_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ds_read_b128 v[6:9], v0
; CHECK-NEXT:    ds_read_b64 v[10:11], v0
; CHECK-NEXT:    s_and_b64 s[2:3], s[0:1], exec
; CHECK-NEXT:    s_cselect_b32 s2, 1, 0
; CHECK-NEXT:    s_cmp_lg_u32 s2, 1
; CHECK-NEXT:    s_waitcnt lgkmcnt(1)
; CHECK-NEXT:    v_add_f32_e32 v3, v9, v3
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    v_add_f32_e32 v5, v11, v5
; CHECK-NEXT:    v_add_f32_e32 v4, v10, v4
; CHECK-NEXT:    v_add_f32_e32 v2, v8, v2
; CHECK-NEXT:    v_add_f32_e32 v1, v7, v1
; CHECK-NEXT:    v_add_f32_e32 v0, v6, v0
; CHECK-NEXT:    s_cbranch_scc1 .LBB0_1
; CHECK-NEXT:  ; %bb.2: ; %ret
; CHECK-NEXT:    ds_write_b64 v0, v[4:5]
; CHECK-NEXT:    ds_write_b128 v0, v[0:3]
; CHECK-NEXT:    s_endpgm
entry:
  br label %loop

loop:
  %phi = phi <6 x float> [ poison, %entry ], [ %add, %loop ]
  %load = load volatile <6 x float>, ptr addrspace(3) poison
  %add = fadd <6 x float> %load, %phi
  br i1 %cond, label %loop, label %ret

ret:
  store volatile <6 x float> %add, ptr addrspace(3) poison
  ret void
}

; The moved argument is a tuple whose subregisters are extracted by SGPR
; copies (created while it was still an SGPR). Widening it to VGPR must
; re-legalize those subregister copies rather than leave illegal ones.
define amdgpu_kernel void @move_divergent_block_arg_to_vgpr_tuple(ptr addrspace(3) %ptr, i1 %cond) {
; CHECK-LABEL: move_divergent_block_arg_to_vgpr_tuple:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_load_dword s0, s[8:9], 0x4
; CHECK-NEXT:    ; implicit-def: $vgpr0
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    s_bitcmp1_b32 s0, 0
; CHECK-NEXT:    s_cselect_b64 s[0:1], -1, 0
; CHECK-NEXT:    s_xor_b64 s[0:1], s[0:1], -1
; CHECK-NEXT:  .LBB1_1: ; %loop
; CHECK-NEXT:    ; =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ds_read_b128 v[4:7], v0
; CHECK-NEXT:    s_and_b64 s[2:3], s[0:1], exec
; CHECK-NEXT:    s_cselect_b32 s2, 1, 0
; CHECK-NEXT:    s_cmp_lg_u32 s2, 1
; CHECK-NEXT:    s_waitcnt lgkmcnt(0)
; CHECK-NEXT:    v_add_u32_e32 v3, v7, v3
; CHECK-NEXT:    v_add_u32_e32 v2, v6, v2
; CHECK-NEXT:    v_add_u32_e32 v1, v5, v1
; CHECK-NEXT:    v_add_u32_e32 v0, v4, v0
; CHECK-NEXT:    s_cbranch_scc1 .LBB1_1
; CHECK-NEXT:  ; %bb.2: ; %ret
; CHECK-NEXT:    ds_write_b128 v0, v[0:3]
; CHECK-NEXT:    s_endpgm
entry:
  br label %loop

loop:
  %phi = phi <4 x i32> [ poison, %entry ], [ %add, %loop ]
  %load = load volatile <4 x i32>, ptr addrspace(3) poison
  %add = add <4 x i32> %load, %phi
  br i1 %cond, label %loop, label %ret

ret:
  store volatile <4 x i32> %add, ptr addrspace(3) poison
  ret void
