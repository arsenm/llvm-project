# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=reg-bank-select -verify-machineinstrs %s -o - | FileCheck %s

# The G_SPLAT_VECTOR scalar source is a block argument, which has no defining
# instruction. RISCVRegisterBankInfo::getInstrMapping must not dereference the
# null def when deciding the operand's bank.
--- |
  define <vscale x 1 x i32> @splat_block_arg(i64 %n, i64 %x) {
  entry:
    br label %loop
  loop:
    br label %loop
  exit:
    ret <vscale x 1 x i32> poison
  }
...
---
name:            splat_block_arg
legalized:       true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: splat_block_arg
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gprb(s64) = COPY $x10
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gprb(s64) = COPY $x11
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY1]](s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   arguments: %2(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[SPLAT_VECTOR:%[0-9]+]]:vrb(<vscale x 1 x s32>) = G_SPLAT_VECTOR %2:gprb(s64)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %2:gprb(s64)
  ; CHECK-NEXT:   G_BR %bb.1
  bb.0.entry:
    successors: %bb.1
    liveins: $x10, $x11

    %0:_(s64) = COPY $x10
    %1:_(s64) = COPY $x11
    G_SUCC_ARGS %bb.1, %1(s64)

  bb.1.loop:
    successors: %bb.1
    arguments: %2:_(s64)

    %3:_(<vscale x 1 x s32>) = G_SPLAT_VECTOR %2(s64)
    G_SUCC_ARGS %bb.1, %2(s64)
    G_BR %bb.1
...
