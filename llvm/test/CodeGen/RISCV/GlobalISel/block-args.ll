; RUN: llc -mtriple=riscv64 -global-isel -gisel-use-block-args -verify-machineinstrs < %s | FileCheck %s
; RUN: llc -mtriple=riscv64 -global-isel -verify-machineinstrs < %s | FileCheck %s

; Exercise RISCV GISel G_SUCC_ARGS selection and register-bank mapping of
; block-argument operands: a loop-carried value forwarded via SUCC_ARGS is used
; as a G_SELECT source and stored, whose bank mappers walk the operand's
; defining instruction (null for a block argument).
define i32 @loop_carried_select(i32 %n, i32 %a, i32 %b, ptr %p) {
; CHECK-LABEL: loop_carried_select:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a4, 0
; CHECK-NEXT:    sext.w a5, a0
; CHECK-NEXT:    j .LBB0_2
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    # in Loop: Header=BB0_2 Depth=1
; CHECK-NEXT:    addiw a4, a4, 1
; CHECK-NEXT:    sw a0, 0(a3)
; CHECK-NEXT:    bgeu a4, a5, .LBB0_4
; CHECK-NEXT:  .LBB0_2: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    mv a0, a1
; CHECK-NEXT:    bltu a4, a5, .LBB0_1
; CHECK-NEXT:  # %bb.3: # %loop
; CHECK-NEXT:    # in Loop: Header=BB0_2 Depth=1
; CHECK-NEXT:    mv a1, a2
; CHECK-NEXT:    j .LBB0_1
; CHECK-NEXT:  .LBB0_4: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %acc = phi i32 [ %a, %entry ], [ %sel, %loop ]
  %iv.next = add i32 %iv, 1
  %cond = icmp ult i32 %iv, %n
  %sel = select i1 %cond, i32 %acc, i32 %b
  store i32 %acc, ptr %p
  %done = icmp uge i32 %iv.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret i32 %acc
}
