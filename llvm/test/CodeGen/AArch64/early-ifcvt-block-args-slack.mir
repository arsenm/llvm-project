# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=early-ifcvt -o - %s | FileCheck %s

# The slack of a block argument and the depths of its forwarded values are
# taken from the traces like for a PHI. The select would put the deep
# condition on the critical path through the long chain using %8.

---
name: not_converted
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: not_converted
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $x1, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = COPY $x2
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr64 = COPY $x1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY $x0
  ; CHECK-NEXT:   [[LDRXui:%[0-9]+]]:gpr64 = LDRXui [[COPY]], 0
  ; CHECK-NEXT:   [[LDRXroX:%[0-9]+]]:gpr64 = LDRXroX [[COPY]], [[LDRXui]], 0, 1
  ; CHECK-NEXT:   [[LDRXroX1:%[0-9]+]]:gpr64common = LDRXroX [[COPY]], [[LDRXroX]], 0, 1
  ; CHECK-NEXT:   [[SUBSXri:%[0-9]+]]:gpr64 = SUBSXri [[LDRXroX1]], 0, 0, implicit-def $nzcv
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[COPY2]]
  ; CHECK-NEXT:   Bcc 1, %bb.2, implicit $nzcv
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADDXrr:%[0-9]+]]:gpr64 = ADDXrr [[COPY2]], [[COPY1]]
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, [[ADDXrr]]
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MADDXrrr:%[0-9]+]]:gpr64 = MADDXrrr %8:gpr64, %8:gpr64, $xzr
  ; CHECK-NEXT:   [[MADDXrrr1:%[0-9]+]]:gpr64 = MADDXrrr [[MADDXrrr]], [[MADDXrrr]], $xzr
  ; CHECK-NEXT:   [[MADDXrrr2:%[0-9]+]]:gpr64 = MADDXrrr [[MADDXrrr1]], [[MADDXrrr1]], $xzr
  ; CHECK-NEXT:   [[MADDXrrr3:%[0-9]+]]:gpr64 = MADDXrrr [[MADDXrrr2]], [[MADDXrrr2]], $xzr
  ; CHECK-NEXT:   [[MADDXrrr4:%[0-9]+]]:gpr64 = MADDXrrr [[MADDXrrr3]], [[MADDXrrr3]], $xzr
  ; CHECK-NEXT:   [[MADDXrrr5:%[0-9]+]]:gpr64 = MADDXrrr [[MADDXrrr4]], [[MADDXrrr4]], $xzr
  ; CHECK-NEXT:   $x0 = COPY [[MADDXrrr5]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x0, $x1, $x2
    %2:gpr64common = COPY $x2
    %1:gpr64 = COPY $x1
    %0:gpr64 = COPY $x0
    %3:gpr64 = LDRXui %2, 0
    %4:gpr64 = LDRXroX %2, %3, 0, 1
    %5:gpr64common = LDRXroX %2, %4, 0, 1
    %7:gpr64 = SUBSXri %5, 0, 0, implicit-def $nzcv
    SUCC_ARGS %bb.2, %0
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.2
    %6:gpr64 = ADDXrr %0, %1
    SUCC_ARGS %bb.2, %6
    B %bb.2

  bb.2:
    arguments: %8:gpr64
    %9:gpr64 = MADDXrrr %8, %8, $xzr
    %10:gpr64 = MADDXrrr %9, %9, $xzr
    %11:gpr64 = MADDXrrr %10, %10, $xzr
    %12:gpr64 = MADDXrrr %11, %11, $xzr
    %13:gpr64 = MADDXrrr %12, %12, $xzr
    %14:gpr64 = MADDXrrr %13, %13, $xzr
    $x0 = COPY %14
    RET_ReallyLR implicit $x0
...

# A shallow condition and short chain is converted.

---
name: converted
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: converted
  ; CHECK: bb.0:
  ; CHECK-NEXT:   liveins: $x0, $x1, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64common = COPY $x2
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr64 = COPY $x1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY $x0
  ; CHECK-NEXT:   [[SUBSXri:%[0-9]+]]:gpr64 = SUBSXri [[COPY]], 0, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[ADDXrr:%[0-9]+]]:gpr64 = ADDXrr [[COPY2]], [[COPY1]]
  ; CHECK-NEXT:   [[CSELXr:%[0-9]+]]:gpr64 = CSELXr [[COPY2]], [[ADDXrr]], 1, implicit $nzcv
  ; CHECK-NEXT:   [[MADDXrrr:%[0-9]+]]:gpr64 = MADDXrrr [[CSELXr]], [[CSELXr]], $xzr
  ; CHECK-NEXT:   $x0 = COPY [[MADDXrrr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x0, $x1, $x2
    %2:gpr64common = COPY $x2
    %1:gpr64 = COPY $x1
    %0:gpr64 = COPY $x0
    %7:gpr64 = SUBSXri %2, 0, 0, implicit-def $nzcv
    SUCC_ARGS %bb.2, %0
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.2
    %6:gpr64 = ADDXrr %0, %1
    SUCC_ARGS %bb.2, %6
    B %bb.2

  bb.2:
    arguments: %8:gpr64
    %9:gpr64 = MADDXrrr %8, %8, $xzr
    $x0 = COPY %9
    RET_ReallyLR implicit $x0
...
