# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=phi-node-elimination -verify-machineinstrs %s -o - | FileCheck %s

# A block-argument block whose back edge forwards one of its own arguments (%b)
# into another (%a). When lowering %a's copy, the source %b is still a def-less
# block argument, so it must be lowered to a COPY rather than misclassified as
# undef. Clearing the block-argument set before emitting the copies would make
# isBlockArgDef(%b) return false and silently drop the loop-carried value to an
# IMPLICIT_DEF.
---
name:            selfref_fwd
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: selfref_fwd
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64 = COPY $x0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr64 = COPY $xzr
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY [[COPY]]
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr64 = COPY [[COPY1]]
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %a:gpr64 = COPY [[COPY2]]
  ; CHECK-NEXT:   %b:gpr64 = COPY [[COPY3]]
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY %b
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr64 = COPY [[COPY]]
  ; CHECK-NEXT:   B %bb.1
  bb.0:
    liveins: $x0
    successors: %bb.1

    %0:gpr64 = COPY $x0
    %1:gpr64 = COPY $xzr
    SUCC_ARGS %bb.1, %0, %1
    B %bb.1

  bb.1:
    successors: %bb.1
    arguments: %a:gpr64, %b:gpr64

    SUCC_ARGS %bb.1, %b, %0
    B %bb.1
...
