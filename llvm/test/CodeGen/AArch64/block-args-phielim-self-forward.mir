# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=phi-node-elimination -verify-machineinstrs %s -o - | FileCheck -check-prefix=NOLIS %s
# RUN: llc -mtriple=aarch64 -run-pass=liveintervals,phi-node-elimination %s -o - | FileCheck -check-prefix=LIS %s

# A block-argument block whose back edge forwards one of its own arguments (%b)
# into another (%a). When lowering %a's copy, the source %b is still a def-less
# block argument, so it must be lowered to a COPY rather than misclassified as
# undef. Clearing the block-argument set before emitting the copies would make
# isBlockArgDef(%b) return false and silently drop the loop-carried value to an
# IMPLICIT_DEF.
---
name:            selfref_fwd
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; NOLIS-LABEL: name: selfref_fwd
  ; NOLIS: bb.0:
  ; NOLIS-NEXT:   successors: %bb.1(0x80000000)
  ; NOLIS-NEXT:   liveins: $x0
  ; NOLIS-NEXT: {{  $}}
  ; NOLIS-NEXT:   [[COPY:%[0-9]+]]:gpr64 = COPY $x0
  ; NOLIS-NEXT:   [[COPY1:%[0-9]+]]:gpr64 = COPY $xzr
  ; NOLIS-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY [[COPY]]
  ; NOLIS-NEXT:   [[COPY3:%[0-9]+]]:gpr64 = COPY [[COPY1]]
  ; NOLIS-NEXT:   B %bb.1
  ; NOLIS-NEXT: {{  $}}
  ; NOLIS-NEXT: bb.1:
  ; NOLIS-NEXT:   successors: %bb.1(0x80000000)
  ; NOLIS-NEXT: {{  $}}
  ; NOLIS-NEXT:   %a:gpr64 = COPY [[COPY2]]
  ; NOLIS-NEXT:   %b:gpr64 = COPY [[COPY3]]
  ; NOLIS-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY %b
  ; NOLIS-NEXT:   [[COPY3:%[0-9]+]]:gpr64 = COPY [[COPY]]
  ; NOLIS-NEXT:   B %bb.1
  ;
  ; LIS-LABEL: name: selfref_fwd
  ; LIS: bb.0:
  ; LIS-NEXT:   successors: %bb.1(0x80000000)
  ; LIS-NEXT:   liveins: $x0
  ; LIS-NEXT: {{  $}}
  ; LIS-NEXT:   [[COPY:%[0-9]+]]:gpr64 = COPY $x0
  ; LIS-NEXT:   [[COPY1:%[0-9]+]]:gpr64 = COPY $xzr
  ; LIS-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY [[COPY]]
  ; LIS-NEXT:   [[COPY3:%[0-9]+]]:gpr64 = COPY [[COPY1]]
  ; LIS-NEXT:   B %bb.1
  ; LIS-NEXT: {{  $}}
  ; LIS-NEXT: bb.1:
  ; LIS-NEXT:   successors: %bb.1(0x80000000)
  ; LIS-NEXT: {{  $}}
  ; LIS-NEXT:   dead %a:gpr64 = COPY [[COPY2]]
  ; LIS-NEXT:   %b:gpr64 = COPY [[COPY3]]
  ; LIS-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY %b
  ; LIS-NEXT:   [[COPY3:%[0-9]+]]:gpr64 = COPY [[COPY]]
  ; LIS-NEXT:   B %bb.1
  bb.0:
    liveins: $x0
    successors: %bb.1

    %0:gpr64 = COPY $x0
    %1:gpr64 = COPY $xzr
    SUCC_ARGS %bb.1, %0, %1
    B %bb.1

  bb.1:
    successors: %bb.1
    arguments: %a:gpr64, %b:gpr64

    SUCC_ARGS %bb.1, %b, %0
    B %bb.1
...
