# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=early-ifcvt -o - %s | FileCheck %s

# Converting a block argument to a select removes the argument. Its DBG_PHI
# must go with it rather than be rewritten to read the select.

---
name: dbg_phi_block_arg
tracksRegLiveness: true
usesBlockArgs: true
debugInstrRef: true
body: |
  ; CHECK-LABEL: name: dbg_phi_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   liveins: $x0, $x1, $x2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64sp = COPY $x2
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr64 = COPY $x1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr64 = COPY $x0
  ; CHECK-NEXT:   [[SUBSXri:%[0-9]+]]:gpr64 = SUBSXri [[COPY]], 0, 0, implicit-def $nzcv
  ; CHECK-NEXT:   [[ADDXrr:%[0-9]+]]:gpr64 = ADDXrr [[COPY2]], [[COPY1]]
  ; CHECK-NEXT:   [[CSELXr:%[0-9]+]]:gpr64 = CSELXr [[COPY2]], [[ADDXrr]], 1, implicit $nzcv
  ; CHECK-NEXT:   $x0 = COPY [[CSELXr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x0, $x1, $x2
    %2:gpr64sp = COPY $x2
    %1:gpr64 = COPY $x1
    %0:gpr64 = COPY $x0
    %3:gpr64 = SUBSXri %2, 0, 0, implicit-def $nzcv
    SUCC_ARGS %bb.2, %0
    Bcc 1, %bb.2, implicit $nzcv
    B %bb.1

  bb.1:
    successors: %bb.2
    %4:gpr64 = ADDXrr %0, %1
    SUCC_ARGS %bb.2, %4
    B %bb.2

  bb.2:
    arguments: %5:gpr64
    DBG_PHI %5, 1
    $x0 = COPY %5
    RET_ReallyLR implicit $x0
...
