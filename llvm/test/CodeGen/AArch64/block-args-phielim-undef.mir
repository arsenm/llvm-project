# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=phi-node-elimination -verify-machineinstrs %s -o - | FileCheck %s

# Lowering block arguments must handle an undef forwarded value: it has no def
# to copy from, so emit an IMPLICIT_DEF for the shared incoming register (as PHI
# lowering does) rather than a COPY that reads an undefined register.
---
name:            undef_fwd
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: undef_fwd
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr32 = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $w0
  ; CHECK-NEXT:   TBNZW [[COPY]], 0, %bb.2
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr32 = COPY [[COPY1]]
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr32 = IMPLICIT_DEF
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   %a:gpr32 = COPY [[COPY2]]
  ; CHECK-NEXT:   $w0 = COPY %a
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $w0
    successors: %bb.1, %bb.2

    %0:gpr32 = COPY $w0
    %1:gpr32 = COPY $w0
    TBNZW %0, 0, %bb.2
    B %bb.1

  bb.1:
    successors: %bb.3

    SUCC_ARGS %bb.3, %1
    B %bb.3

  bb.2:
    successors: %bb.3

    SUCC_ARGS %bb.3, undef %2:gpr32
    B %bb.3

  bb.3:
    arguments: %a:gpr32

    $w0 = COPY %a
    RET_ReallyLR implicit $w0
...
