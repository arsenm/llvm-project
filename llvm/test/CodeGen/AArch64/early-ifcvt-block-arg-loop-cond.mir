# RUN: llc -mtriple=arm64-apple-darwin -run-pass=early-ifcvt -verify-machineinstrs -o - %s | FileCheck %s

# The branch condition of a loop header is a block-argument register (def-less,
# forwarded by SUCC_ARGS). EarlyIfConversion's loop-predictability heuristic
# called getVRegDef() on it and dereferenced the null result. It must treat a
# def-less block-argument register as not loop-invariant instead of crashing.

--- |
  define void @f(i64 %x) { ret void }
...
---
name:            f
tracksRegLiveness: true
isSSA:           true
usesBlockArgs:   true
registers:
  - { id: 0, class: gpr64 }
  - { id: 1, class: gpr64 }
  - { id: 2, class: gpr64 }
  - { id: 3, class: gpr64 }
  - { id: 4, class: gpr64 }
liveins:
  - { reg: '$x0', virtual-reg: '%0' }
body:             |
  ; CHECK-LABEL: name: f
  bb.0:
    successors: %bb.1
    liveins: $x0

    %0:gpr64 = COPY $x0
    SUCC_ARGS %bb.1, %0
    B %bb.1

  bb.1:
    successors: %bb.3(0x40000000), %bb.2(0x40000000)
    arguments: %1

    CBZX %1:gpr64, %bb.3
    B %bb.2

  bb.2:
    successors: %bb.4

    %2:gpr64 = ADDXrr %1:gpr64, %1:gpr64
    SUCC_ARGS %bb.4, %2
    B %bb.4

  bb.3:
    successors: %bb.4

    %3:gpr64 = SUBXrr %1:gpr64, %1:gpr64
    SUCC_ARGS %bb.4, %3

  bb.4:
    successors: %bb.1

    arguments: %4

    SUCC_ARGS %bb.1, %4
    B %bb.1
...
