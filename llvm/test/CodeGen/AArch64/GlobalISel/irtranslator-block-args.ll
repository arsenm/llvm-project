latch:
  %c2 = icmp eq i32 %acc.next, 0
  br i1 %c2, label %head, label %side
side:
  %s = phi i32 [ %acc.next, %latch ]
  ret i32 %s
exit:
  %e = phi i32 [ %acc, %head ]
  ret i32 %e
}
