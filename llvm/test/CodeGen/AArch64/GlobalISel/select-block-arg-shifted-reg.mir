# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=instruction-select %s -o - | FileCheck %s

# selectShiftedRegister reads the defining instruction of an operand to look for
# a shift to fold into the user. A block-argument operand has no defining
# instruction, so the selector must bail rather than dereference a null def.
--- |
  define i32 @shifted_reg_block_arg(i32 %n) {
  entry:
    br label %loop
  loop:
    br label %loop
  exit:
    ret i32 0
  }
...
---
name:            shifted_reg_block_arg
legalized:       true
regBankSelected: true
tracksRegLiveness: true
usesBlockArgs:   true
registers:
  - { id: 0, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 1, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 2, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 3, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 4, class: _, preferred-register: '', flags: [  ] }
  - { id: 5, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 6, class: _, preferred-register: '', flags: [  ] }
  - { id: 7, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 8, class: gpr, preferred-register: '', flags: [  ] }
  - { id: 9, class: _, preferred-register: '', flags: [  ] }
  - { id: 10, class: gpr, preferred-register: '', flags: [  ] }
liveins:
  - { reg: '$w0' }
body:             |
  ; CHECK-LABEL: name: shifted_reg_block_arg
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr32 = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $wzr
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY1]], [[COPY1]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.1(0x7c000000), %bb.2(0x04000000)
  ; CHECK-NEXT:   arguments: %1, %2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADDWrr:%[0-9]+]]:gpr32 = ADDWrr %2:gpr32, %1:gpr32common
  ; CHECK-NEXT:   [[ADDWri:%[0-9]+]]:gpr32common = ADDWri %1:gpr32common, 1, 0
  ; CHECK-NEXT:   [[SUBSWrr:%[0-9]+]]:gpr32 = SUBSWrr [[ADDWri]], [[COPY]], implicit-def $nzcv
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[ADDWri]], [[ADDWrr]]
  ; CHECK-NEXT:   Bcc 11, %bb.1, implicit $nzcv
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.exit:
  ; CHECK-NEXT:   $w0 = COPY [[ADDWrr]]
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.1.entry:
    successors: %bb.2(0x80000000)
    liveins: $w0

    %0:gpr(i32) = COPY $w0
    %7:gpr(i32) = G_CONSTANT i32 0
    G_SUCC_ARGS %bb.2, %7(i32), %7(i32)

  bb.2.loop:
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    arguments: %1(i32), %2(i32)

    %3:gpr(i32) = G_ADD %2:gpr, %1:gpr
    %8:gpr(i32) = G_CONSTANT i32 1
    %5:gpr(i32) = G_ADD %1:gpr, %8
    %10:gpr(i32) = G_ICMP intpred(slt), %5(i32), %0
    G_SUCC_ARGS %bb.2, %5(i32), %3(i32)
    G_BRCOND %10(i32), %bb.2
    G_BR %bb.3

  bb.3.exit:
    $w0 = COPY %3(i32)
    RET_ReallyLR implicit $w0
...
