# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=reg-bank-select %s -o - | FileCheck %s

# RegBankSelect assigns register banks to block-argument receiver registers, even
# though they have no defining instruction. Because the def-driven walk never
# visits them, their bank is seeded from the values their predecessors forward,
# like a copy-like PHI. A block argument whose only use is copy-like (e.g. a copy
# to a physical register) has nothing to repair its bank from, so this seeding is
# required for it to end up banked.
--- |
  define i32 @loop(i32 %n) {
  entry:
    br label %loop
  loop:
    br label %loop
  exit:
    ret i32 0
  }
  define i32 @copy_only_use(i32 %x) {
    br label %next
  next:
    ret i32 %x
  }
  define void @hetero() {
    br label %next
  next:
    ret void
  }
...
---
name:            loop
legalized:       true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: loop
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr(s32) = COPY $w0
  ; CHECK-NEXT:   [[C:%[0-9]+]]:gpr(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[C]](s32), [[C]](s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   arguments: %2(s32), %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:gpr(s32) = G_ADD %3:gpr, %2:gpr
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:gpr(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[ADD1:%[0-9]+]]:gpr(s32) = G_ADD %2:gpr, [[C1]]
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:gpr(s32) = G_ICMP intpred(slt), [[ADD1]](s32), [[COPY]]
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[ADD1]](s32), [[ADD]](s32)
  ; CHECK-NEXT:   G_BRCOND [[ICMP]](s32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.exit:
  ; CHECK-NEXT:   $w0 = COPY [[ADD]](s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0.entry:
    successors: %bb.1
    liveins: $w0

    %0:_(s32) = COPY $w0
    %7:_(s32) = G_CONSTANT i32 0
    G_SUCC_ARGS %bb.1, %7(s32), %7(s32)

  bb.1.loop:
    successors: %bb.1, %bb.2
    arguments: %1:_(s32), %2:_(s32)

    %3:_(s32) = G_ADD %2, %1
    %8:_(s32) = G_CONSTANT i32 1
    %5:_(s32) = G_ADD %1, %8
    %10:_(s32) = G_ICMP intpred(slt), %5(s32), %0
    G_SUCC_ARGS %bb.1, %5(s32), %3(s32)
    G_BRCOND %10(s32), %bb.1
    G_BR %bb.2

  bb.2.exit:
    $w0 = COPY %3(s32)
    RET_ReallyLR implicit $w0
...
---
# The block argument in bb.1 is only used by a copy to a physical register, which
# imposes no bank constraint. Its bank must be seeded from the forwarded value.
name:            copy_only_use
legalized:       true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: copy_only_use
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr(s32) = COPY $w0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[COPY]](s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %1(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $w0 = COPY %1:gpr(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.1
    liveins: $w0

    %0:_(s32) = COPY $w0
    G_SUCC_ARGS %bb.1, %0(s32)
    G_BR %bb.1

  bb.1:
    arguments: %1:_(s32)

    $w0 = COPY %1(s32)
    RET_ReallyLR implicit $w0
...
---
# Heterogeneous block arguments (s32, s64, and an s32 later used by an FADD) are
# each seeded from the bank of the value forwarded to them; the FADD use of the
# third argument is repaired to fpr when the use is processed.
name:            hetero
legalized:       true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: hetero
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $x1, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %g32:gpr(s32) = COPY $w0
  ; CHECK-NEXT:   %g64:gpr(s64) = COPY $x1
  ; CHECK-NEXT:   %f32:fpr(s32) = COPY $s0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr(i32) = COPY %f32(s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %g32(s32), %g64(s64), [[COPY]](i32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %3(s32), %4(s64), %5(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:fpr(i32) = COPY %a2:gpr(s32)
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:fpr(i32) = COPY %a2:gpr(s32)
  ; CHECK-NEXT:   %fa:fpr(s32) = G_FADD [[COPY1]], [[COPY2]]
  ; CHECK-NEXT:   $w0 = COPY %a0:gpr(s32)
  ; CHECK-NEXT:   $x1 = COPY %a1:gpr(s64)
  ; CHECK-NEXT:   $s0 = COPY %fa(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0, implicit $x1, implicit $s0
  bb.0:
    successors: %bb.1
    liveins: $w0, $x1, $s0

    %g32:_(s32) = COPY $w0
    %g64:_(s64) = COPY $x1
    %f32:_(s32) = COPY $s0
    G_SUCC_ARGS %bb.1, %g32(s32), %g64(s64), %f32(s32)
    G_BR %bb.1

  bb.1:
    arguments: %a0:_(s32), %a1:_(s64), %a2:_(s32)

    %fa:_(s32) = G_FADD %a2, %a2
    $w0 = COPY %a0(s32)
    $x1 = COPY %a1(s64)
    $s0 = COPY %fa(s32)
    RET_ReallyLR implicit $w0, implicit $x1, implicit $s0
...
