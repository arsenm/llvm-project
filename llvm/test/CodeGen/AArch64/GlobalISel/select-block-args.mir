# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=instruction-select %s -o - | FileCheck %s

# G_SUCC_ARGS selects to the SUCC_ARGS pseudo. The successor's block-argument
# receiver registers have no defining instruction, so instruction selection must
# constrain them to a register class (as it does for a PHI def).
---
name:            sel_succ_args
legalized:       true
regBankSelected: true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: sel_succ_args
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:gpr32all = COPY $w0
  ; CHECK-NEXT:   %y:gpr32all = COPY $w1
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, %x, %y
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2, %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $w0 = COPY %a:gpr32
  ; CHECK-NEXT:   $w1 = COPY %b:gpr32
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0, implicit $w1
  bb.0:
    liveins: $w0, $w1
    successors: %bb.1
    %x:gpr(s32) = COPY $w0
    %y:gpr(s32) = COPY $w1
    G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
    G_BR %bb.1
  bb.1:
    arguments: %a:gpr(s32), %b:gpr(s32)
    $w0 = COPY %a(s32)
    $w1 = COPY %b(s32)
    RET_ReallyLR implicit $w0, implicit $w1
...
---
# A block reached from two predecessors with heterogeneous block arguments
# (gpr64 + fpr32): each predecessor's G_SUCC_ARGS selects to SUCC_ARGS and the
# receiver registers are constrained to the register class matching each
# forwarded value's bank.
name:            sel_hetero
legalized:       true
regBankSelected: true
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: sel_hetero
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $w0, $x1, $s0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %c:gpr32 = COPY $w0
  ; CHECK-NEXT:   %g:gpr64all = COPY $x1
  ; CHECK-NEXT:   %f:fpr32 = COPY $s0
  ; CHECK-NEXT:   TBNZW %c, 0, %bb.2
  ; CHECK-NEXT:   B %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOVi32imm:%[0-9]+]]:gpr32 = MOVi32imm 7
  ; CHECK-NEXT:   %g1:gpr64all = SUBREG_TO_REG [[MOVi32imm]], %subreg.sub_32
  ; CHECK-NEXT:   %f1:fpr32 = FMOVSi 112
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, %g1, %f1
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SUCC_ARGS %bb.3, %g, %f
  ; CHECK-NEXT:   B %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   arguments: %7, %8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = COPY %ag:gpr64
  ; CHECK-NEXT:   $s0 = COPY %af:fpr32
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0, implicit $s0
  bb.0:
    liveins: $w0, $x1, $s0
    successors: %bb.1, %bb.2

    %c:gpr(s32) = COPY $w0
    %g:gpr(s64) = COPY $x1
    %f:fpr(s32) = COPY $s0
    %cc:gpr(s32) = G_CONSTANT i32 1
    %ct:gpr(s32) = G_AND %c, %cc
    G_BRCOND %ct(s32), %bb.2
    G_BR %bb.1

  bb.1:
    successors: %bb.3

    %g1:gpr(s64) = G_CONSTANT i64 7
    %f1:fpr(s32) = G_FCONSTANT float 1.0
    G_SUCC_ARGS %bb.3, %g1(s64), %f1(s32)
    G_BR %bb.3

  bb.2:
    successors: %bb.3

    G_SUCC_ARGS %bb.3, %g(s64), %f(s32)
    G_BR %bb.3

  bb.3:
    arguments: %ag:gpr(s64), %af:fpr(s32)

    $x0 = COPY %ag(s64)
    $s0 = COPY %af(s32)
    RET_ReallyLR implicit $x0, implicit $s0
...
