# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer %s -o - | FileCheck %s

# G_SUCC_ARGS forwards a variadic list of independently-typed values to its
# successor's block arguments. widenScalarSuccArgs must widen every illegal
# forwarded value (and its matching block argument) in one step, each to its own
# legal type, not only the first.
---
name:            widen_both_same
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: widen_both_same
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:_(s32) = COPY $w0
  ; CHECK-NEXT:   %y:_(s32) = COPY $w1
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(s16) = G_TRUNC %x(s32)
  ; CHECK-NEXT:   [[TRUNC1:%[0-9]+]]:_(s16) = G_TRUNC %y(s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[TRUNC]](s16), [[TRUNC1]](s16)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %4(s16), %5(s16)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ANYEXT:%[0-9]+]]:_(s32) = G_ANYEXT %a:_(s16)
  ; CHECK-NEXT:   [[ANYEXT1:%[0-9]+]]:_(s32) = G_ANYEXT %b:_(s16)
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(s32) = G_ADD [[ANYEXT]], [[ANYEXT1]]
  ; CHECK-NEXT:   $w0 = COPY [[ADD]](s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $w0, $w1
    successors: %bb.1
    %x:_(s32) = COPY $w0
    %y:_(s32) = COPY $w1
    %xt:_(s8) = G_TRUNC %x
    %yt:_(s8) = G_TRUNC %y
    G_SUCC_ARGS %bb.1, %xt(s8), %yt(s8)
    G_BR %bb.1
  bb.1:
    arguments: %a:_(s8), %b:_(s8)
    %s:_(s8) = G_ADD %a, %b
    %z:_(s32) = G_ANYEXT %s(s8)
    $w0 = COPY %z(s32)
    RET_ReallyLR implicit $w0
...
---
name:            widen_both_different
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: widen_both_different
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:_(s32) = COPY $w0
  ; CHECK-NEXT:   %y:_(s32) = COPY $w1
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(s16) = G_TRUNC %x(s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[TRUNC]](s16), %y(s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %4(s16), %5(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %az:_(s32) = G_ANYEXT %a:_(s16)
  ; CHECK-NEXT:   %s:_(s32) = G_ADD %az, %b:_
  ; CHECK-NEXT:   $w0 = COPY %s(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $w0, $w1
    successors: %bb.1
    %x:_(s32) = COPY $w0
    %y:_(s32) = COPY $w1
    %xt:_(s8) = G_TRUNC %x
    %yt:_(s24) = G_TRUNC %y
    G_SUCC_ARGS %bb.1, %xt(s8), %yt(s24)
    G_BR %bb.1
  bb.1:
    arguments: %a:_(s8), %b:_(s24)
    %az:_(s32) = G_ANYEXT %a(s8)
    %bz:_(s32) = G_ANYEXT %b(s24)
    %s:_(s32) = G_ADD %az, %bz
    $w0 = COPY %s(s32)
    RET_ReallyLR implicit $w0
...
