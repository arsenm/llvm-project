# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer -global-isel-abort=1 %s -o - | FileCheck %s

# A single G_SUCC_ARGS can forward arguments needing different legalization
# actions. Here one invocation must widen the s8 argument, narrow the s128
# argument into two s64 parts, and split the <8 x s32> argument into two
# <4 x s32> parts, keeping every argument's positional correspondence between
# the receiver list and each predecessor's forwarder.
---
name:            mixed
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: mixed
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $q0, $q1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %lo:_(<4 x s32>) = COPY $q0
  ; CHECK-NEXT:   %hi:_(<4 x s32>) = COPY $q1
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:_(s64) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:_(s16) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[DEF]](s64), [[DEF]](s64), [[DEF1]](s16), %lo(<4 x s32>), %hi(<4 x s32>)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %20(s64), %21(s64), %6(s16), %15(<4 x s32>), %16(<4 x s32>)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = COPY %20:_(s64)
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    liveins: $q0, $q1
    successors: %bb.1

    %lo:_(<4 x s32>) = COPY $q0
    %hi:_(<4 x s32>) = COPY $q1
    %z:_(<8 x s32>) = G_CONCAT_VECTORS %lo, %hi
    %x:_(s128) = G_IMPLICIT_DEF
    %y:_(s8) = G_IMPLICIT_DEF
    G_SUCC_ARGS %bb.1, %x(s128), %y(s8), %z(<8 x s32>)
    G_BR %bb.1

  bb.1:
    arguments: %a:_(s128), %b:_(s8), %c:_(<8 x s32>)

    %al:_(s64), %ah:_(s64) = G_UNMERGE_VALUES %a(s128)
    %be:_(s32) = G_ANYEXT %b(s8)
    %i:_(s64) = G_CONSTANT i64 0
    %ce:_(s32) = G_EXTRACT_VECTOR_ELT %c(<8 x s32>), %i(s64)
    $x0 = COPY %al(s64)
    RET_ReallyLR implicit $x0
...
