# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer -global-isel-abort=1 %s -o - | FileCheck %s

# When a block with arguments has multiple predecessors, narrowing a block
# argument must update the forwarder in every predecessor: each G_SUCC_ARGS for
# the join block unmerges its forwarded s128 value into the two s64 parts.
---
name:            multipred
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: multipred
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %c:_(s32) = COPY $w0
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:_(s32) = G_AND %c, [[C]]
  ; CHECK-NEXT:   G_BRCOND [[AND]](s32), %bb.2
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:_(s64) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.3, [[DEF]](s64), [[DEF]](s64)
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF1:%[0-9]+]]:_(s64) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.3, [[DEF1]](s64), [[DEF1]](s64)
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   arguments: %7(s64), %8(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = COPY %7:_(s64)
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    liveins: $w0
    successors: %bb.1, %bb.2

    %c:_(s32) = COPY $w0
    %cc:_(s1) = G_TRUNC %c(s32)
    G_BRCOND %cc(s1), %bb.2
    G_BR %bb.1

  bb.1:
    successors: %bb.3

    %x:_(s128) = G_IMPLICIT_DEF
    G_SUCC_ARGS %bb.3, %x(s128)
    G_BR %bb.3

  bb.2:
    successors: %bb.3

    %y:_(s128) = G_IMPLICIT_DEF
    G_SUCC_ARGS %bb.3, %y(s128)
    G_BR %bb.3

  bb.3:
    arguments: %a:_(s128)

    %al:_(s64), %ah:_(s64) = G_UNMERGE_VALUES %a(s128)
    $x0 = COPY %al(s64)
    RET_ReallyLR implicit $x0
...
