# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner %s -o - | FileCheck %s

# Several combines walk from an operand through copies to its defining
# instruction (getDefIgnoringCopies / getDefSrcRegIgnoringCopies) and inspect
# the opcode, or match it as a constant (m_GConstantOrFConstantBits). A
# block-argument register has no defining instruction, so these walks must stop
# gracefully instead of dereferencing a null def.

# getDefIgnoringCopies through a copy of a block argument (matchCombineTruncOfShift).
---
name:            trunc_of_copy_of_block_arg
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: trunc_of_copy_of_block_arg
  ; CHECK: arguments: %{{[0-9]+}}
  bb.0:
    liveins: $x0
    successors: %bb.1

    %x:_(s64) = COPY $x0
    G_SUCC_ARGS %bb.1, %x(s64)
    G_BR %bb.1

  bb.1:
    arguments: %arg:_(s64)

    %cp:_(s64) = COPY %arg
    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %cp(s64)
    $w0 = COPY %lo(s32)
    RET_ReallyLR implicit $w0
...

# getDefSrcRegIgnoringCopies walking two copies of a block argument to compare
# their definitions (matchEqualDefs, select_same_val).
---
name:            select_same_copies_of_block_arg
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: select_same_copies_of_block_arg
  ; CHECK: arguments: %{{[0-9]+}}
  bb.0:
    liveins: $w0
    successors: %bb.1

    %x:_(s32) = COPY $w0
    G_SUCC_ARGS %bb.1, %x(s32)
    G_BR %bb.1

  bb.1:
    arguments: %arg:_(s32)

    %cp1:_(s32) = COPY %arg
    %cp2:_(s32) = COPY %arg
    %cond:_(s1) = G_TRUNC %cp1
    %sel:_(s32) = G_SELECT %cond(s1), %cp1(s32), %cp2(s32)
    $w0 = COPY %sel(s32)
    RET_ReallyLR implicit $w0
...

# m_GConstantOrFConstantBits matched on a block argument (matchCombineUnmergeConstant).
---
name:            unmerge_constant_of_block_arg
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: unmerge_constant_of_block_arg
  ; CHECK: arguments: %{{[0-9]+}}
  bb.0:
    liveins: $x0
    successors: %bb.1

    %x:_(s64) = COPY $x0
    G_SUCC_ARGS %bb.1, %x(s64)
    G_BR %bb.1

  bb.1:
    arguments: %arg:_(s64)

    %lo:_(s32), %hi:_(s32) = G_UNMERGE_VALUES %arg(s64)
    $w0 = COPY %lo(s32)
    $w1 = COPY %hi(s32)
    RET_ReallyLR implicit $w0, implicit $w1
...
