; A loop-carried pointer is a block argument with no defining instruction. The
; addressing-mode selectors (selectAddrModeIndexed / selectAddrModeWRO /
; selectExtendedSHL) must not dereference its null def when it feeds a load,
; store, or a scaled-offset G_PTR_ADD.
define i32 @block_arg_ptr_addrmode(ptr %p, i32 %n) {
; CHECK-LABEL: block_arg_ptr_addrmode:
; CHECK:       // %bb.0: // %entry
; CHECK-NEXT:    mov x9, xzr
; CHECK-NEXT:    mov x10, xzr
; CHECK-NEXT:  .LBB0_1: // %loop
; CHECK-NEXT:    // =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    ldr w8, [x0, x9]
; CHECK-NEXT:    add x9, x9, #8
; CHECK-NEXT:    str w8, [x0, x10, lsl #2]
; CHECK-NEXT:    add x10, x10, #1
; CHECK-NEXT:    cmp w10, w1
; CHECK-NEXT:    b.lo .LBB0_1
; CHECK-NEXT:  // %bb.2: // %exit
; CHECK-NEXT:    mov w0, w8
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %pp = phi ptr [ %p, %entry ], [ %pp.next, %loop ]
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %loop ]
  %idx = zext i32 %iv to i64
  %elt = getelementptr i32, ptr %pp, i64 %idx
  %v = load i32, ptr %elt
  store i32 %v, ptr %pp
  %pp.next = getelementptr i32, ptr %pp, i64 1
  %iv.next = add i32 %iv, 1
  %c = icmp ult i32 %iv.next, %n
  br i1 %c, label %loop, label %exit
exit:
  ret i32 %v
}
