# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner %s -o - | FileCheck %s

# Block arguments feed a variety of binary operations (add/and/mul/shl/or/xor).
# The combiner's operand def-walks (matchUnaryPredicate, matchShiftsTooBig,
# GFConstant/GIConstant::getConstant, ...) must tolerate a def-less block-arg
# operand rather than dereferencing a null def.
---
name:            st
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: st
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:_(s64) = COPY $x0
  ; CHECK-NEXT:   %y:_(s64) = COPY $x1
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %x(s64), %y(s64)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2(s64), %3(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %add:_(s64) = G_ADD %a:_, %b:_
  ; CHECK-NEXT:   %mul:_(s64) = G_MUL %a:_, %b:_
  ; CHECK-NEXT:   %shl:_(s64) = G_SHL %a:_, %b:_(s64)
  ; CHECK-NEXT:   %or:_(s64) = G_OR %add, %a:_
  ; CHECK-NEXT:   %xor:_(s64) = G_XOR %mul, %shl
  ; CHECK-NEXT:   %r:_(s64) = G_OR %or, %xor
  ; CHECK-NEXT:   $x0 = COPY %r(s64)
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    liveins: $x0, $x1
    successors: %bb.1
    %x:_(s64) = COPY $x0
    %y:_(s64) = COPY $x1
    G_SUCC_ARGS %bb.1, %x(s64), %y(s64)
    G_BR %bb.1
  bb.1:
    arguments: %a:_(s64), %b:_(s64)
    %add:_(s64) = G_ADD %a, %b
    %and:_(s64) = G_AND %a, %b
    %mul:_(s64) = G_MUL %a, %b
    %shl:_(s64) = G_SHL %a, %b(s64)
    %or:_(s64) = G_OR %add, %and
    %xor:_(s64) = G_XOR %mul, %shl
    %r:_(s64) = G_OR %or, %xor
    $x0 = COPY %r(s64)
    RET_ReallyLR implicit $x0
...
