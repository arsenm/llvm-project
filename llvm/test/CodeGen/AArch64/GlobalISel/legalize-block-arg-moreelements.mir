# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer %s -o - | FileCheck %s

# A block-argument vector with a non-power-of-two element count needs the
# MoreElements action, just like a G_PHI of the same type. moreElementsSuccArgs
# must pad each predecessor's forwarded value with undef elements, retype the
# shared block argument, and delete the trailing elements to recover the
# original type for the block's own uses.
---
name:            more_elements_block_arg
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: more_elements_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %p:_(p0) = COPY $x0
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:_(s32) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   [[BUILD_VECTOR:%[0-9]+]]:_(<4 x s32>) = G_BUILD_VECTOR [[DEF]](s32), [[DEF]](s32), [[DEF]](s32), [[DEF]](s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[BUILD_VECTOR]](<4 x s32>)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2(<4 x s32>)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:_(<4 x s32>) = G_ADD %arg:_, %arg:_
  ; CHECK-NEXT:   [[UV:%[0-9]+]]:_(s32), [[UV1:%[0-9]+]]:_(s32), [[UV2:%[0-9]+]]:_(s32), [[UV3:%[0-9]+]]:_(s32) = G_UNMERGE_VALUES [[ADD]](<4 x s32>)
  ; CHECK-NEXT:   G_STORE [[UV]](s32), %p(p0) :: (store (s32), align 16)
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 4
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD %p, [[C]](i64)
  ; CHECK-NEXT:   G_STORE [[UV1]](s32), [[PTR_ADD]](p0) :: (store (s32) into unknown-address + 4)
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(i64) = G_CONSTANT i64 8
  ; CHECK-NEXT:   [[PTR_ADD1:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD %p, [[C1]](i64)
  ; CHECK-NEXT:   G_STORE [[UV2]](s32), [[PTR_ADD1]](p0) :: (store (s32) into unknown-address + 8, align 8)
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    liveins: $x0
    successors: %bb.1

    %p:_(p0) = COPY $x0
    %v:_(<3 x s32>) = G_IMPLICIT_DEF
    G_SUCC_ARGS %bb.1, %v(<3 x s32>)
    G_BR %bb.1

  bb.1:
    arguments: %arg:_(<3 x s32>)

    %r:_(<3 x s32>) = G_ADD %arg, %arg
    G_STORE %r(<3 x s32>), %p(p0) :: (store (<3 x s32>))
    RET_ReallyLR
...
