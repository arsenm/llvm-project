# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s

# Selecting a G_BRJT emits the jump-table address computation (JumpTableDest32)
# and its debug marker, which are not terminators. When the block has a
# SUCC_ARGS cluster they must be emitted before it, not at the branch (which
# sits after the cluster). Only the BR terminator stays after the cluster.
---
name:            brjt
legalized:       true
regBankSelected: true
tracksRegLiveness: true
usesBlockArgs:   true
jumpTable:
  kind:            block-address
  entries:
    - id:              0
      blocks:          [ '%bb.1', '%bb.2' ]
body:             |
  ; CHECK-LABEL: name: brjt
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[MOVaddrJT:%[0-9]+]]:gpr64common = MOVaddrJT target-flags(aarch64-page) %jump-table.0, target-flags(aarch64-pageoff, aarch64-nc) %jump-table.0
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64 = COPY $x0
  ; CHECK-NEXT:   %fwd:gpr64all = COPY $x1
  ; CHECK-NEXT:   early-clobber %4:gpr64, early-clobber %5:gpr64sp = JumpTableDest32 [[MOVaddrJT]], [[COPY]], %jump-table.0
  ; CHECK-NEXT:   JUMP_TABLE_DEBUG_INFO 0
  ; CHECK-NEXT:   SUCC_ARGS %bb.2, %fwd
  ; CHECK-NEXT:   BR %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   RET_ReallyLR
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = COPY %a:gpr64
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    liveins: $x0, $x1
    successors: %bb.1, %bb.2

    %0:gpr(p0) = G_JUMP_TABLE %jump-table.0
    %1:gpr(s64) = COPY $x0
    %fwd:gpr(s64) = COPY $x1
    G_SUCC_ARGS %bb.2, %fwd(s64)
    G_BRJT %0(p0), %jump-table.0, %1(s64)

  bb.1:
    RET_ReallyLR

  bb.2:
    arguments: %a:gpr(s64)

    $x0 = COPY %a(s64)
    RET_ReallyLR implicit $x0
...
