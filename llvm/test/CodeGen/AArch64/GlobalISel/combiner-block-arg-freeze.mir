# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner %s -o - | FileCheck %s

# The freeze combine (match_freeze_of_non_undef_non_poison) walks operand defs
# via isGuaranteedNotToBeUndefOrPoison. A def-less block-arg operand must be
# treated conservatively (not guaranteed non-poison) rather than dereferenced.
---
name:            frz
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: frz
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:_(s32) = COPY $w0
  ; CHECK-NEXT:   %y:_(s32) = COPY $w1
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2(s32), %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %add:_(s32) = G_ADD %a:_, %b:_
  ; CHECK-NEXT:   %f:_(s32) = G_FREEZE %add
  ; CHECK-NEXT:   $w0 = COPY %f(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $w0, $w1
    successors: %bb.1
    %x:_(s32) = COPY $w0
    %y:_(s32) = COPY $w1
    G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
    G_BR %bb.1
  bb.1:
    arguments: %a:_(s32), %b:_(s32)
    %add:_(s32) = G_ADD %a, %b
    %f:_(s32) = G_FREEZE %add
    $w0 = COPY %f(s32)
    RET_ReallyLR implicit $w0
...
---
name:            frz_bv
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: frz_bv
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:_(s32) = COPY $w0
  ; CHECK-NEXT:   %y:_(s32) = COPY $w1
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2(s32), %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %f:_(s32) = G_FREEZE %a:_
  ; CHECK-NEXT:   $w0 = COPY %f(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $w0, $w1
    successors: %bb.1
    %x:_(s32) = COPY $w0
    %y:_(s32) = COPY $w1
    G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
    G_BR %bb.1
  bb.1:
    arguments: %a:_(s32), %b:_(s32)
    %f:_(s32) = G_FREEZE %a
    $w0 = COPY %f(s32)
    RET_ReallyLR implicit $w0
...
