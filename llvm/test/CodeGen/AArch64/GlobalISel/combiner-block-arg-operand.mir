# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner %s -o - | FileCheck %s

# A combine rule records the defining instruction of an operand that is a copy
# of a block argument. A block argument has no defining instruction, so the
# match-table's GIM_RecordInsn must reject the match (as it does for a physical
# register) instead of storing a null instruction and asserting later.
---
name:            copy_of_block_arg_operand
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: copy_of_block_arg_operand
  ; CHECK: arguments: %{{[0-9]+}}
  bb.0:
    liveins: $w0
    successors: %bb.1

    %x:_(i32) = COPY $w0
    G_SUCC_ARGS %bb.1, %x(i32)
    G_BR %bb.1

  bb.1:
    arguments: %arg:_(i32)

    %cp:_(i32) = COPY %arg
    %z:_(i64) = G_ZEXT %cp(i32)
    %t:_(i32) = G_TRUNC %z(i64)
    $w0 = COPY %t(i32)
    RET_ReallyLR implicit $w0
...
