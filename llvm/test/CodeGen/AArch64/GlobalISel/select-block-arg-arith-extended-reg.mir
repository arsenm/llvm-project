# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s

# selectArithExtendedRegister folds a G_ZEXT into its user and, for a 32-bit
# UXTW source, reads the source's defining instruction to check isDef32. A
# block-argument source has no defining instruction, so the selector must bail
# rather than dereference a null def.
--- |
  define i64 @arith_extended_block_arg(i32 %n, i64 %base) {
  entry:
    br label %loop
  loop:
    br label %loop
  exit:
    ret i64 0
  }
...
---
name:            arith_extended_block_arg
legalized:       true
regBankSelected: true
tracksRegLiveness: true
usesBlockArgs:   true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gpr }
  - { id: 4, class: gpr }
  - { id: 5, class: gpr }
  - { id: 6, class: gpr }
  - { id: 7, class: gpr }
liveins:
  - { reg: '$w0' }
  - { reg: '$x1' }
body:             |
  ; CHECK-LABEL: name: arith_extended_block_arg
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr64all = COPY $x1
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr32 = COPY $wzr
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[COPY1]], [[COPY]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   arguments: %3, %4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADDXrx:%[0-9]+]]:gpr64sp = ADDXrx %4:gpr64common, %3:gpr32common, 16
  ; CHECK-NEXT:   [[ADDWri:%[0-9]+]]:gpr32sp = ADDWri %3:gpr32common, 0, 0
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[ADDWri]], [[ADDXrx]]
  ; CHECK-NEXT:   B %bb.1
  bb.0.entry:
    successors: %bb.1(0x80000000)
    liveins: $w0, $x1

    %0:gpr(i32) = COPY $w0
    %1:gpr(i64) = COPY $x1
    %2:gpr(i32) = G_CONSTANT i32 0
    G_SUCC_ARGS %bb.1, %2(i32), %1(i64)

  bb.1.loop:
    successors: %bb.1(0x80000000)
    arguments: %3(i32), %4(i64)

    %5:gpr(i64) = G_ZEXT %3:gpr(i32)
    %6:gpr(i64) = G_ADD %4:gpr, %5
    %7:gpr(i32) = G_ADD %3:gpr, %2
    G_SUCC_ARGS %bb.1, %7(i32), %6(i64)
    G_BR %bb.1
...
