# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer -global-isel-abort=1 %s -o - | FileCheck %s

# Widening a G_BRCOND condition materializes an extension (and a bool cleanup);
# these are not terminators, so they must be emitted before the block's
# SUCC_ARGS cluster, not at the branch (which sits after the cluster).
---
name:            brcond_widen
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: brcond_widen
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $w0, $w1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(s32) = COPY $w0
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(s32) = COPY $w1
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:_(s32) = G_AND [[COPY]], [[C]]
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.2, [[COPY1]](s32)
  ; CHECK-NEXT:   G_BRCOND [[AND]](s32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 7
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.2, [[C1]](s32)
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %5(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $w0 = COPY %a:_(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $w0, $w1
    successors: %bb.1, %bb.2

    %0:_(s32) = COPY $w0
    %1:_(s8) = G_TRUNC %0(s32)
    %2:_(s1) = G_TRUNC %1(s8)
    %3:_(s32) = COPY $w1
    G_SUCC_ARGS %bb.2, %3(s32)
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.2

    %4:_(s32) = G_CONSTANT i32 7
    G_SUCC_ARGS %bb.2, %4(s32)
    G_BR %bb.2

  bb.2:
    arguments: %a:_(s32)

    $w0 = COPY %a(s32)
    RET_ReallyLR implicit $w0
...
