# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer -global-isel-abort=1 %s -o - | FileCheck %s

# narrowScalar splits a too-wide block argument into narrower parts: the receiver
# block-argument list gains one entry per part and each predecessor's G_SUCC_ARGS
# unmerges the forwarded value into the matching parts, preserving positional
# correspondence (including when a split argument precedes other arguments).
---
name:            narrow_first
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: narrow_first
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %p:_(s64) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %p(s64), %p(s64), %p(s64)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %7(s64), %8(s64), %3(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %t:_(s64) = G_ADD %a:_, %7:_
  ; CHECK-NEXT:   $x0 = COPY %t(s64)
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    successors: %bb.1
    %x:_(s128) = G_IMPLICIT_DEF
    %p:_(s64) = G_IMPLICIT_DEF
    G_SUCC_ARGS %bb.1, %x(s128), %p(s64)
    G_BR %bb.1
  bb.1:
    arguments: %b:_(s128), %a:_(s64)
    %bl:_(s64), %bh:_(s64) = G_UNMERGE_VALUES %b(s128)
    %t:_(s64) = G_ADD %a, %bl
    $x0 = COPY %t(s64)
    RET_ReallyLR implicit $x0
...
