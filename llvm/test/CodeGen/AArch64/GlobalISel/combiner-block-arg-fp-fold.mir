# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=aarch64-prelegalizer-combiner %s -o - | FileCheck %s

# The FP constant-fold combine (matchConstantFoldFPBinOp) reads each operand's
# G_FCONSTANT via getConstantFPVRegVal, which dereferences the operand def. A
# def-less block-arg operand must return "not a constant" rather than crash.
---
name:            fp_binop
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: fp_binop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $s0, $s1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:_(s32) = COPY $s0
  ; CHECK-NEXT:   %y:_(s32) = COPY $s1
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2(s32), %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %fa:_(s32) = G_FADD %a:_, %b:_
  ; CHECK-NEXT:   %fm:_(s32) = G_FMUL %fa, %a:_
  ; CHECK-NEXT:   $s0 = COPY %fm(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $s0
  bb.0:
    liveins: $s0, $s1
    successors: %bb.1
    %x:_(s32) = COPY $s0
    %y:_(s32) = COPY $s1
    G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
    G_BR %bb.1
  bb.1:
    arguments: %a:_(s32), %b:_(s32)
    %fa:_(s32) = G_FADD %a, %b
    %fm:_(s32) = G_FMUL %fa, %a
    $s0 = COPY %fm(s32)
    RET_ReallyLR implicit $s0
...
---
name:            fp_copysign
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: fp_copysign
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $s0, $s1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:_(s32) = COPY $s0
  ; CHECK-NEXT:   %y:_(s32) = COPY $s1
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2(s32), %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %c:_(s32) = G_FCOPYSIGN %a:_, %b:_(s32)
  ; CHECK-NEXT:   $s0 = COPY %c(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $s0
  bb.0:
    liveins: $s0, $s1
    successors: %bb.1
    %x:_(s32) = COPY $s0
    %y:_(s32) = COPY $s1
    G_SUCC_ARGS %bb.1, %x(s32), %y(s32)
    G_BR %bb.1
  bb.1:
    arguments: %a:_(s32), %b:_(s32)
    %c:_(s32) = G_FCOPYSIGN %a, %b(s32)
    $s0 = COPY %c(s32)
    RET_ReallyLR implicit $s0
...
