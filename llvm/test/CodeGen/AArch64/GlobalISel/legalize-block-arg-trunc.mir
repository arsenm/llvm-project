# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer %s -o - | FileCheck %s

# The legalization artifact combiner walks operand defs via
# getDefSrcRegIgnoringCopies (findValueFromDefImpl). A def-less block-arg
# operand returns no definition; the walk must stop rather than dereference an
# empty optional.
---
name:            trunc_of_blockarg
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: trunc_of_blockarg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0, $x1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %x:_(s64) = COPY $x0
  ; CHECK-NEXT:   %y:_(s64) = COPY $x1
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %x(s64), %y(s64)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %2(s64), %3(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %t:_(s32) = G_TRUNC %a:_(s64)
  ; CHECK-NEXT:   %u:_(s32) = G_TRUNC %b:_(s64)
  ; CHECK-NEXT:   %s:_(s32) = G_ADD %t, %u
  ; CHECK-NEXT:   $w0 = COPY %s(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    liveins: $x0, $x1
    successors: %bb.1
    %x:_(s64) = COPY $x0
    %y:_(s64) = COPY $x1
    G_SUCC_ARGS %bb.1, %x(s64), %y(s64)
    G_BR %bb.1
  bb.1:
    arguments: %a:_(s64), %b:_(s64)
    %t:_(s32) = G_TRUNC %a(s64)
    %u:_(s32) = G_TRUNC %b(s64)
    %s:_(s32) = G_ADD %t, %u
    $w0 = COPY %s(s32)
    RET_ReallyLR implicit $w0
...
