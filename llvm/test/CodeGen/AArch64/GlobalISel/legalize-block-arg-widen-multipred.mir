# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer -global-isel-abort=1 %s -o - | FileCheck %s

# Widening a block argument reached from multiple predecessors must widen the
# receiver and every predecessor's forwarded value consistently, keeping the
# forwarder operand types in sync with the receiver.
---
name:            widen_multipred
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: widen_multipred
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $w0, $x1, $w2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %c:_(s32) = COPY $w0
  ; CHECK-NEXT:   %p:_(p0) = COPY $x1
  ; CHECK-NEXT:   %w:_(s32) = COPY $w2
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[AND:%[0-9]+]]:_(s32) = G_AND %c, [[C]]
  ; CHECK-NEXT:   G_BRCOND [[AND]](s32), %bb.2
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(s16) = G_TRUNC %w(s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.3, [[TRUNC]](s16), %p(p0)
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[TRUNC1:%[0-9]+]]:_(s16) = G_TRUNC %w(s32)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.3, [[TRUNC1]](s16), %p(p0)
  ; CHECK-NEXT:   G_BR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   arguments: %6(s16), %7(p0)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[TRUNC2:%[0-9]+]]:_(s8) = G_TRUNC %a:_(s16)
  ; CHECK-NEXT:   G_STORE [[TRUNC2]](s8), %ap:_(p0) :: (store (s8))
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    liveins: $w0, $x1, $w2
    successors: %bb.1, %bb.2

    %c:_(s32) = COPY $w0
    %p:_(p0) = COPY $x1
    %w:_(s32) = COPY $w2
    %cc:_(s1) = G_TRUNC %c(s32)
    %v0:_(s8) = G_TRUNC %w(s32)
    G_BRCOND %cc(s1), %bb.2
    G_BR %bb.1

  bb.1:
    successors: %bb.3

    G_SUCC_ARGS %bb.3, %v0(s8), %p(p0)
    G_BR %bb.3

  bb.2:
    successors: %bb.3

    %v1:_(s8) = G_TRUNC %w(s32)
    G_SUCC_ARGS %bb.3, %v1(s8), %p(p0)
    G_BR %bb.3

  bb.3:
    arguments: %a:_(s8), %ap:_(p0)

    G_STORE %a(s8), %ap(p0) :: (store (s8))
    RET_ReallyLR
...
