# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=instruction-select -verify-machineinstrs %s -o - | FileCheck %s

# When a G_BRCOND is fed by a G_ICMP that folds into a flag-setting compare +
# Bcc, the compare is not a terminator and must be emitted before the block's
# SUCC_ARGS cluster, not at the branch (which sits after the cluster).
--- |
  define i32 @loop(i32 %n) {
  entry:
    br label %loop
  loop:
    br label %loop
  exit:
    ret i32 0
  }
...
---
name:            loop
legalized:       true
regBankSelected: true
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: loop
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr32(s32) = COPY $w0
  ; CHECK-NEXT:   [[C:%[0-9]+]]:gpr(s32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[C]](s32), [[C]](s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.loop:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   arguments: %2(s32), %3(s32)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:gpr(s32) = G_ADD %3:gpr32, %2:gpr32
  ; CHECK-NEXT:   [[C1:%[0-9]+]]:gpr(s32) = G_CONSTANT i32 1
  ; CHECK-NEXT:   [[ADD1:%[0-9]+]]:gpr32(s32) = G_ADD %2:gpr32, [[C1]]
  ; CHECK-NEXT:   [[SUBSWrr:%[0-9]+]]:gpr32 = SUBSWrr [[ADD1]](s32), [[COPY]](s32), implicit-def $nzcv
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[ADD1]](s32), [[ADD]](s32)
  ; CHECK-NEXT:   Bcc 11, %bb.1, implicit $nzcv
  ; CHECK-NEXT:   B %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.exit:
  ; CHECK-NEXT:   $w0 = COPY [[ADD]](s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0.entry:
    successors: %bb.1
    liveins: $w0

    %0:gpr(s32) = COPY $w0
    %7:gpr(s32) = G_CONSTANT i32 0
    G_SUCC_ARGS %bb.1, %7(s32), %7(s32)

  bb.1.loop:
    successors: %bb.1, %bb.2
    arguments: %1:gpr(s32), %2:gpr(s32)

    %3:gpr(s32) = G_ADD %2, %1
    %8:gpr(s32) = G_CONSTANT i32 1
    %5:gpr(s32) = G_ADD %1, %8
    %10:gpr(s32) = G_ICMP intpred(slt), %5(s32), %0
    G_SUCC_ARGS %bb.1, %5(s32), %3(s32)
    G_BRCOND %10(s32), %bb.1
    G_BR %bb.2

  bb.2.exit:
    $w0 = COPY %3(s32)
    RET_ReallyLR implicit $w0
...
