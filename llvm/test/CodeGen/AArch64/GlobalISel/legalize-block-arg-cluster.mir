# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer -global-isel-abort=1 %s -o - | FileCheck %s

# Narrowing a block argument unmerges the value forwarded by each predecessor.
# The unmerge must go before the predecessor's whole SUCC_ARGS cluster, not just
# before the G_SUCC_ARGS being rewritten, which need not be the first one.
---
name:            second_in_cluster
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: second_in_cluster
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $w0, $x1, $q0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %c:_(s32) = COPY $w0
  ; CHECK-NEXT:   %x:_(s64) = COPY $x1
  ; CHECK-NEXT:   %wide:_(s128) = COPY $q0
  ; CHECK-NEXT:   [[UV:%[0-9]+]]:_(s64), [[UV1:%[0-9]+]]:_(s64) = G_UNMERGE_VALUES %wide(s128)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, %x(s64)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.2, [[UV]](s64), [[UV1]](s64)
  ; CHECK-NEXT:   G_BRCOND %c(s32), %bb.2
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   arguments: %3(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(s64) = G_CONSTANT i64 0
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.2, %3:_(s64), [[C]](s64)
  ; CHECK-NEXT:   G_BR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   arguments: %7(s64), %8(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = COPY %7:_(s64)
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $w0, $x1, $q0

    %c:_(s32) = COPY $w0
    %x:_(s64) = COPY $x1
    %wide:_(s128) = COPY $q0
    G_SUCC_ARGS %bb.1, %x(s64)
    G_SUCC_ARGS %bb.2, %wide(s128)
    G_BRCOND %c(s32), %bb.2
    G_BR %bb.1

  bb.1:
    successors: %bb.2
    arguments: %3:_(s64)

    %b:_(s128) = G_ZEXT %3(s64)
    G_SUCC_ARGS %bb.2, %b(s128)
    G_BR %bb.2

  bb.2:
    arguments: %4:_(s128)

    %t:_(s64) = G_TRUNC %4(s128)
    $x0 = COPY %t(s64)
    RET_ReallyLR implicit $x0
...

# A predecessor that branches to the block on both edges has one G_SUCC_ARGS
# for it, which must only be rewritten once.
---
name:            two_edges
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: two_edges
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $w0, $x1, $q0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %c:_(s32) = COPY $w0
  ; CHECK-NEXT:   %x:_(s64) = COPY $x1
  ; CHECK-NEXT:   %wide:_(s128) = COPY $q0
  ; CHECK-NEXT:   [[UV:%[0-9]+]]:_(s64), [[UV1:%[0-9]+]]:_(s64) = G_UNMERGE_VALUES %wide(s128)
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[UV]](s64), [[UV1]](s64)
  ; CHECK-NEXT:   G_BRCOND %c(s32), %bb.1
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %5(s64), %6(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = COPY %5:_(s64)
  ; CHECK-NEXT:   RET_ReallyLR implicit $x0
  bb.0:
    successors: %bb.1
    liveins: $w0, $x1, $q0

    %c:_(s32) = COPY $w0
    %x:_(s64) = COPY $x1
    %wide:_(s128) = COPY $q0
    G_SUCC_ARGS %bb.1, %wide(s128)
    G_BRCOND %c(s32), %bb.1
    G_BR %bb.1

  bb.1:
    arguments: %4:_(s128)

    %t:_(s64) = G_TRUNC %4(s128)
    $x0 = COPY %t(s64)
    RET_ReallyLR implicit $x0
...
