# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=aarch64 -run-pass=legalizer -global-isel-abort=1 %s -o - | FileCheck %s

# fewerElements splits a too-wide vector block argument into narrower-vector
# parts: the receiver block-argument list gains one entry per part and each
# predecessor's G_SUCC_ARGS unmerges the forwarded vector into the matching
# parts, preserving positional correspondence with later arguments.
---
name:            fewer_block_arg
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: fewer_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:_(<4 x s32>) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   %y:_(s64) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[DEF]](<4 x s32>), [[DEF]](<4 x s32>), %y(s64)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %8(<4 x s32>), %9(<4 x s32>), %3(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %z:_(s64) = G_CONSTANT i64 0
  ; CHECK-NEXT:   %e:_(s32) = G_EXTRACT_VECTOR_ELT %8:_(<4 x s32>), %z(s64)
  ; CHECK-NEXT:   $w0 = COPY %e(s32)
  ; CHECK-NEXT:   RET_ReallyLR implicit $w0
  bb.0:
    successors: %bb.1
    %x:_(<8 x s32>) = G_IMPLICIT_DEF
    %y:_(s64) = G_IMPLICIT_DEF
    G_SUCC_ARGS %bb.1, %x(<8 x s32>), %y(s64)
    G_BR %bb.1
  bb.1:
    arguments: %a:_(<8 x s32>), %b:_(s64)
    %z:_(s64) = G_CONSTANT i64 0
    %e:_(s32) = G_EXTRACT_VECTOR_ELT %a(<8 x s32>), %z(s64)
    $w0 = COPY %e(s32)
    RET_ReallyLR implicit $w0
...
---
# Scalarize is FewerElements with a scalar part type: a vector block argument
# whose element is wider than a legal vector element (here <2 x s128>, element
# s128 > 64) is split into scalar parts. splitSuccArg must accept the
# vector->scalar shape, matching how G_PHI scalarizes.
name:            scalarize_block_arg
tracksRegLiveness: true
usesBlockArgs:   true
body:             |
  ; CHECK-LABEL: name: scalarize_block_arg
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x0
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   %p:_(p0) = COPY $x0
  ; CHECK-NEXT:   [[DEF:%[0-9]+]]:_(s64) = G_IMPLICIT_DEF
  ; CHECK-NEXT:   G_SUCC_ARGS %bb.1, [[DEF]](s64), [[DEF]](s64), [[DEF]](s64), [[DEF]](s64)
  ; CHECK-NEXT:   G_BR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %46(s64), %47(s64), %41(s64), %42(s64)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[UADDO:%[0-9]+]]:_(s64), [[UADDO1:%[0-9]+]]:_(i32) = G_UADDO %46:_, %46:_
  ; CHECK-NEXT:   [[UADDE:%[0-9]+]]:_(s64), [[UADDE1:%[0-9]+]]:_(i32) = G_UADDE %47:_, %47:_, [[UADDO1]]
  ; CHECK-NEXT:   [[MV:%[0-9]+]]:_(s128) = G_MERGE_VALUES [[UADDO]](s64), [[UADDE]](s64)
  ; CHECK-NEXT:   [[UADDO2:%[0-9]+]]:_(s64), [[UADDO3:%[0-9]+]]:_(i32) = G_UADDO %41:_, %41:_
  ; CHECK-NEXT:   [[UADDE2:%[0-9]+]]:_(s64), [[UADDE3:%[0-9]+]]:_(i32) = G_UADDE %42:_, %42:_, [[UADDO3]]
  ; CHECK-NEXT:   [[MV1:%[0-9]+]]:_(s128) = G_MERGE_VALUES [[UADDO2]](s64), [[UADDE2]](s64)
  ; CHECK-NEXT:   G_STORE [[MV]](s128), %p(p0) :: (store (s128), align 32)
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 16
  ; CHECK-NEXT:   [[PTR_ADD:%[0-9]+]]:_(p0) = nuw inbounds G_PTR_ADD %p, [[C]](i64)
  ; CHECK-NEXT:   G_STORE [[MV1]](s128), [[PTR_ADD]](p0) :: (store (s128) into unknown-address + 16)
  ; CHECK-NEXT:   RET_ReallyLR
  bb.0:
    liveins: $x0
    successors: %bb.1

    %p:_(p0) = COPY $x0
    %v:_(<2 x s128>) = G_IMPLICIT_DEF
    G_SUCC_ARGS %bb.1, %v(<2 x s128>)
    G_BR %bb.1

  bb.1:
    arguments: %arg:_(<2 x s128>)

    %r:_(<2 x s128>) = G_ADD %arg, %arg
    G_STORE %r(<2 x s128>), %p(p0) :: (store (<2 x s128>))
    RET_ReallyLR
...
