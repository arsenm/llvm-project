# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=powerpc64le-- -run-pass=pipeliner -ppc-enable-pipeliner %s -o - | FileCheck %s

# The pipeliner requires LiveIntervals, which runs before PHI elimination
# lowers block arguments. A block-argument register has no defining
# instruction; LiveIntervals must model its value as defined at the entry of
# its block, like a PHI, rather than failing to find a reaching def.

---
name: block_arg_liveintervals
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: name: block_arg_liveintervals
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[LI:%[0-9]+]]:gprc = LI 7
  ; CHECK-NEXT:   SUCC_ARGS %bb.1, [[LI]]
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   arguments: %1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $r3 = COPY %1:gprc
  ; CHECK-NEXT:   BLR implicit $lr, implicit $rm, implicit $r3
  bb.0:
    successors: %bb.1
    %0:gprc = LI 7
    SUCC_ARGS %bb.1, %0

  bb.1:
    arguments: %1:gprc
    $r3 = COPY %1
    BLR implicit $lr, implicit $rm, implicit $r3
...
