; The memory pointed to by an argument may be written by the callers, so
; loads from it are not invariant, even though this function only reads it.

define ptr @load_field(ptr %p) {
; CHECK-LABEL: define ptr @load_field(
; CHECK-SAME: ptr nofree readonly align 8 captures(none) [[P:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    [[F:%.*]] = getelementptr i8, ptr [[P]], i64 16
; CHECK-NEXT:    [[V:%.*]] = load ptr, ptr [[F]], align 8
; CHECK-NEXT:    ret ptr [[V]]
;
  %f = getelementptr i8, ptr %p, i64 16
  %v = load ptr, ptr %f, align 8
  ret ptr %v
}

; The same for an internal function whose callers write the memory.
define internal i32 @get(ptr %p) {
; CHECK-LABEL: define internal i32 @get(
; CHECK-SAME: ptr nofree readonly align 4 captures(none) [[P:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[F:%.*]] = getelementptr i8, ptr [[P]], i64 4
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[F]], align 4
; CHECK-NEXT:    ret i32 [[V]]
;
  %f = getelementptr i8, ptr %p, i64 4
  %v = load i32, ptr %f, align 4
  ret i32 %v
}

define i32 @caller(ptr %p) {
  %a = call i32 @get(ptr %p)
  %f = getelementptr i8, ptr %p, i64 4
  store i32 1, ptr %f, align 4
  %b = call i32 @get(ptr %p)
  %s = add i32 %a, %b
  ret i32 %s
}
