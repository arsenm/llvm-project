; RUN: opt -S -passes=attributor < %s | FileCheck %s

; The alloca that replaces a heap allocation must be aligned for the accesses
; to the memory, even if the allocation call does not say anything about the
; alignment.

declare noalias ptr @malloc(i64) allockind("alloc,uninitialized") allocsize(0) "alloc-family"="malloc"
declare void @free(ptr) allockind("free") "alloc-family"="malloc"
declare void @use(ptr nocapture align 16) nounwind willreturn nosync

define i64 @align_from_accesses(i1 %c) {
; CHECK-LABEL: define i64 @align_from_accesses(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:    [[P_H2S:%.*]] = alloca i8, i64 32, align 16
; CHECK-NEXT:    store i64 0, ptr [[P_H2S]], align 8
; CHECK-NEXT:    [[G:%.*]] = getelementptr i8, ptr [[P_H2S]], i64 16
; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[E:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    call void @use(ptr noundef captures(none) [[G]]) #[[ATTR3:[0-9]+]]
; CHECK-NEXT:    br label %[[E]]
; CHECK:       [[E]]:
; CHECK-NEXT:    [[V:%.*]] = load i64, ptr [[P_H2S]], align 8
; CHECK-NEXT:    ret i64 [[V]]
;
  %p = call noalias ptr @malloc(i64 32)
  store i64 0, ptr %p, align 8
  %g = getelementptr i8, ptr %p, i64 16
  br i1 %c, label %t, label %e

t:
  call void @use(ptr %g)
  br label %e

e:
  %v = load i64, ptr %p, align 8
  call void @free(ptr %p)
  ret i64 %v
}
