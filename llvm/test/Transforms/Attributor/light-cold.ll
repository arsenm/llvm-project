; Like FunctionAttrs, the light CGSCC pass infers cold for functions where all
; paths call a cold function.

declare void @cold_fn() cold

define void @calls_cold() {
; CHECK-LABEL: define void @calls_cold(
; CHECK-SAME: ) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:    call void @cold_fn()
; CHECK-NEXT:    ret void
;
  call void @cold_fn()
  ret void
}

define void @calls_cold_transitively(i1 %c) {
; CHECK-LABEL: define void @calls_cold_transitively(
; CHECK-SAME: i1 [[C:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[E:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    call void @calls_cold()
; CHECK-NEXT:    ret void
; CHECK:       [[E]]:
; CHECK-NEXT:    call void @cold_fn()
; CHECK-NEXT:    ret void
;
  br i1 %c, label %t, label %e
t:
  call void @calls_cold()
  ret void
e:
  call void @cold_fn()
  ret void
}

define void @calls_cold_conditionally(i1 %c) {
; CHECK-LABEL: define void @calls_cold_conditionally(
; CHECK-SAME: i1 [[C:%.*]]) {
; CHECK-NEXT:    br i1 [[C]], label %[[T:.*]], label %[[E:.*]]
; CHECK:       [[T]]:
; CHECK-NEXT:    call void @cold_fn()
; CHECK-NEXT:    br label %[[E]]
; CHECK:       [[E]]:
; CHECK-NEXT:    ret void
;
  br i1 %c, label %t, label %e
t:
  call void @cold_fn()
  br label %e
e:
  ret void
}
