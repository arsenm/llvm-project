# RUN: llc -mtriple=amdgpu9.00 -run-pass=liveintervals -verify-machineinstrs -filetype=null %s

# Block arguments with only subregister uses get subranges seeded from the
# block-entry def.
---
name: subreg_use_block_arg
tracksRegLiveness: true
usesBlockArgs: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr2_vgpr3, $sgpr0_sgpr1
    successors: %bb.1, %bb.2
    %0:vreg_64 = COPY $vgpr0_vgpr1
    %1:vreg_64 = COPY $vgpr2_vgpr3
    %2:sreg_64 = COPY $sgpr0_sgpr1
    $vcc = COPY %2
    SUCC_ARGS %bb.2, %0
    S_CBRANCH_VCCNZ %bb.2, implicit $vcc
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2
    SUCC_ARGS %bb.2, %1
    S_BRANCH %bb.2

  bb.2:
    arguments: %3:vreg_64
    $vgpr0 = COPY %3.sub0
    SI_RETURN implicit $vgpr0
...
---
name: subreg_use_loop_block_arg
tracksRegLiveness: true
usesBlockArgs: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $sgpr0_sgpr1
    successors: %bb.1
    %0:vreg_64 = COPY $vgpr0_vgpr1
    %2:sreg_64 = COPY $sgpr0_sgpr1
    SUCC_ARGS %bb.1, %0
    S_BRANCH %bb.1

  bb.1:
    arguments: %3:vreg_64
    successors: %bb.1, %bb.2
    %4:vgpr_32 = V_ADD_U32_e32 1, %3.sub0, implicit $exec
    %5:vreg_64 = REG_SEQUENCE %4, %subreg.sub0, %3.sub1, %subreg.sub1
    $vcc = COPY %2
    SUCC_ARGS %bb.1, %5
    S_CBRANCH_VCCNZ %bb.1, implicit $vcc
    S_BRANCH %bb.2

  bb.2:
    $vgpr0 = COPY %4
    SI_RETURN implicit $vgpr0
...
