# RUN: not --crash llc -mtriple=x86_64-- -run-pass=none -filetype=null %s 2>&1 | FileCheck %s

# A G_SUCC_ARGS must forward exactly as many values as the successor has block
# arguments.
# CHECK: *** Bad machine code: G_SUCC_ARGS operand count does not match successor block argument count ***
---
name: count_mismatch
tracksRegLiveness: true
usesBlockArgs: true
body: |
  bb.0:
    successors: %bb.1
    %0:_(s32) = G_IMPLICIT_DEF
    G_SUCC_ARGS %bb.1, %0
    G_BR %bb.1

  bb.1:
    arguments: %1:_(s32), %2:_(s32)
    RET64
...
