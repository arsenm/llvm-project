# RUN: llc -mtriple=x86_64-- -run-pass=liveintervals -verify-machineinstrs -filetype=null %s

# A block argument's live interval starts at the entry of its block and is not
# live out of the predecessors.

---
name: diamond
tracksRegLiveness: true
usesBlockArgs: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $edi, $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY $esi
    SUCC_ARGS %bb.2, %0
    JCC_1 %bb.2, 4, implicit undef $eflags
    JMP_1 %bb.1

  bb.1:
    successors: %bb.2
    SUCC_ARGS %bb.2, %1
    JMP_1 %bb.2

  bb.2:
    arguments: %2:gr32
    $eax = COPY %2
    RET64 implicit $eax
...

---
name: loop
tracksRegLiveness: true
usesBlockArgs: true
body: |
  bb.0:
    successors: %bb.1
    liveins: $edi
    %0:gr32 = COPY $edi
    SUCC_ARGS %bb.1, %0
    JMP_1 %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    arguments: %1:gr32
    %2:gr32 = DEC32r %1, implicit-def $eflags
    SUCC_ARGS %bb.1, %2
    JCC_1 %bb.1, 5, implicit $eflags
    JMP_1 %bb.2

  bb.2:
    $eax = COPY %2
    RET64 implicit $eax
...
