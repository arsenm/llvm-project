# RUN: llc -mtriple=amdgpu9.00-- -run-pass=print-machine-uniformity -o - %s 2>&1 | FileCheck %s
# Block arguments (which have no defining instruction) are handled by the
# uniformity analysis. A block argument fed a divergent value becomes
# divergent, and that divergence propagates to its uses. The same holds for
# both the post-ISel SUCC_ARGS and the generic G_SUCC_ARGS.

--- |
  define void @blockarg_diverge_succ_args() { ret void }
  define void @blockarg_diverge_g_succ_args() { ret void }
  define void @blockarg_temporal_diverge() { ret void }
...

---
name: blockarg_diverge_succ_args
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: MachineUniformityInfo for function: @blockarg_diverge_succ_args
  ; The block argument %3 is divergent, and so is its use.
  ; CHECK: BLOCK bb.2
  ; CHECK: DIVERGENT: %[[ARG:[0-9]+]]{{$}}
  ; CHECK-NEXT: DIVERGENT: %{{[0-9]+}}: %{{[0-9]+}}:_(s32) = G_ADD %[[ARG]]:_, %[[ARG]]:_
  bb.0:
    successors: %bb.1, %bb.2
    %0:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.workitem.id.x)
    %1:_(s32) = G_CONSTANT i32 0
    %2:_(s1) = G_ICMP intpred(slt), %0(s32), %1
    SUCC_ARGS %bb.2, %0
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.2
    SUCC_ARGS %bb.2, %1
    G_BR %bb.2

  bb.2:
    arguments: %3:_(s32)
    %4:_(s32) = G_ADD %3, %3
    S_ENDPGM 0
...

---
name: blockarg_diverge_g_succ_args
tracksRegLiveness: true
usesBlockArgs: true
body: |
  ; CHECK-LABEL: MachineUniformityInfo for function: @blockarg_diverge_g_succ_args
  ; The generic G_SUCC_ARGS behaves identically to SUCC_ARGS.
  ; CHECK: BLOCK bb.2
  ; CHECK: DIVERGENT: %[[ARG:[0-9]+]]{{$}}
  ; CHECK-NEXT: DIVERGENT: %{{[0-9]+}}: %{{[0-9]+}}:_(s32) = G_ADD %[[ARG]]:_, %[[ARG]]:_
  bb.0:
    successors: %bb.1, %bb.2
    %0:_(s32) = G_INTRINSIC intrinsic(@llvm.amdgcn.workitem.id.x)
    %1:_(s32) = G_CONSTANT i32 0
    %2:_(s1) = G_ICMP intpred(slt), %0(s32), %1
    G_SUCC_ARGS %bb.2, %0
    G_BRCOND %2(s1), %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.2
    G_SUCC_ARGS %bb.2, %1
    G_BR %bb.2

  bb.2:
    arguments: %3:_(s32)
    %4:_(s32) = G_ADD %3, %3
    S_ENDPGM 0
...

---
# A uniform value carried by a block argument defined inside a divergently
# exited loop becomes temporally divergent when forwarded out of the loop.
name: blockarg_temporal_diverge
tracksRegLiveness: true
usesBlockArgs: true
legalized: true
body: |
  ; CHECK-LABEL: MachineUniformityInfo for function: @blockarg_temporal_diverge
  ; CHECK: DIVERGENT: SI_LOOP
  ; The exit block argument is fed the loop's block argument.
  ; CHECK: BLOCK bb.2
  ; CHECK: DIVERGENT: %[[ARG:[0-9]+]]{{$}}
  ; CHECK-NEXT: DIVERGENT: %{{[0-9]+}}: %{{[0-9]+}}:_(s32) = G_ADD %[[ARG]]:_, %[[ARG]]:_
  bb.0:
    successors: %bb.1
    %0:_(s64) = G_CONSTANT i64 0
    %1:_(s1) = G_CONSTANT i1 false
    %2:_(s32) = G_CONSTANT i32 7
    SUCC_ARGS %bb.1, %2, %0
    G_BR %bb.1

  bb.1:
    successors: %bb.2, %bb.1
    arguments: %3:_(s32), %4:_(s64)
    %5:sreg_64_xexec(s64) = G_INTRINSIC intrinsic(@llvm.amdgcn.if.break), %1(s1), %4(s64)
    SUCC_ARGS %bb.1, %3, %5
    SUCC_ARGS %bb.2, %3
    SI_LOOP %5(s64), %bb.1, implicit-def $exec, implicit-def $scc, implicit $exec
    G_BR %bb.2

  bb.2:
    arguments: %6:_(s32)
    %7:_(s32) = G_ADD %6, %6
    S_ENDPGM 0
...
